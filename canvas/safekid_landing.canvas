      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n  :root{\n    --ink:#0B2B33; --teal:#255E72; --cyan:#00C7CA; --mint:#83E3E3; --sky:#B7F2F2;\n    --mist:#F4FBFB; --line:#D7EDEF;\n    --display:'Plus Jakarta Sans',system-ui,sans-serif;\n    --text:'Inter',system-ui,sans-serif;\n  }\n  @layer base{\n    body{background:#fff;color:var(--ink);font-family:var(--text);font-size:17px;line-height:1.65;-webkit-font-smoothing:antialiased}\n    a:focus-visible,button:focus-visible{outline:2px solid var(--ink);outline-offset:4px;border-radius:6px}\n    ::selection{background:#B7F2F2;color:#0B2B33}\n  }\n  @layer components{\n    .display{font-family:var(--display);letter-spacing:-.025em;font-weight:600}\n    .pill{display:inline-flex;align-items:center;gap:.6rem;border-radius:999px;padding:.95rem 1.6rem;font-size:15px;font-weight:500;white-space:nowrap;transition:background-color .2s ease,color .2s ease}\n    .linkarrow .arrow{transition:transform .2s ease}\n    .linkarrow:hover .arrow{transform:translateX(4px)}\n    .appstate{position:absolute;inset:0;opacity:0;transform:translateY(14px);transition:opacity .28s ease,transform .28s ease;pointer-events:none}\n    .appstate.is-on{opacity:1;transform:none;pointer-events:auto}\n    .viewbtn{transition:color .2s ease,border-color .2s ease,background-color .2s ease}\n    .viewbtn[aria-pressed=\"true\"]{background:#0B2B33;color:#fff;border-color:#0B2B33}\n    .edimg{position:absolute;inset:0;height:100%;width:100%;object-fit:contain;opacity:0;transition:opacity .18s ease}\n    .edimg.is-active{opacity:1}\n    .thumb{transition:background-color .18s ease}\n    .thumb[aria-current=\"true\"]{outline:2px solid #0B2B33;outline-offset:2px}\n    @media (prefers-reduced-motion: reduce){\n      .appstate{transform:none;transition:opacity .01s linear}\n      .edimg,.thumb,.arrow,.pill{transition:none}\n    }\n  }\n</style>\n<div class=\"w-full overflow-x-clip bg-white\" data-kid=\"1\" data-name=\"page layout container\">\n<!-- NAV -->\n<header class=\"border-b border-[#E4F4F5] bg-white/0\" data-kid=\"1-1\" data-name=\"site header bar\">\n<div class=\"mx-auto flex max-w-[1320px] items-center justify-between px-8 py-6\" data-kid=\"1-1-1\" data-name=\"header inner layout bar\">\n<a aria-label=\"SafeKid home\" class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"site logo link to home\" href=\"#top\">\n<img alt=\"\" class=\"h-9 w-9 object-contain\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/brand/Logo_SafeKid.png\"/>\n<span class=\"display text-[19px] font-bold tracking-[-.02em]\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">SafeKid</span>\n</a>\n<div class=\"flex items-center gap-9\" data-kid=\"1-1-1-2\" data-name=\"header right actions group\">\n<nav aria-label=\"Main\" class=\"flex items-center gap-8 text-[14px] text-[#255E72]\" data-kid=\"1-1-1-2-1\" data-name=\"main navigation links\">\n<a class=\"hover:text-[#0B2B33]\" data-kid=\"1-1-1-2-1-1\" data-name=\"nav link: How it works\" href=\"#reciprocal\">How it works</a>\n<a class=\"hover:text-[#0B2B33]\" data-kid=\"1-1-1-2-1-2\" data-name=\"nav link: Capabilities\" href=\"#capabilities\">Capabilities</a>\n<a class=\"hover:text-[#0B2B33]\" data-kid=\"1-1-1-2-1-3\" data-name=\"nav link: Editions\" href=\"#editions\">Editions</a>\n<a class=\"hover:text-[#0B2B33]\" data-kid=\"1-1-1-2-1-4\" data-name=\"nav link: Try it\" href=\"#demo\">Try it</a>\n</nav>\n<a class=\"text-[14px] font-medium underline decoration-[#B7F2F2] decoration-2 underline-offset-[6px]\" data-kid=\"1-1-1-2-2\" data-name=\"contact link\" href=\"#/contact\">Contact</a>\n</div>\n</div>\n</header>\n<!-- HERO -->\n<section class=\"bg-[#F4FBFB]\" data-kid=\"1-2\" data-name=\"hero section\" id=\"top\">\n<div class=\"mx-auto max-w-[1320px] px-8\" data-kid=\"1-2-1\" data-name=\"hero content container\">\n<div class=\"grid grid-cols-12 gap-8 pt-14\" data-kid=\"1-2-1-1\" data-name=\"hero headline and intro grid\">\n<h1 class=\"display col-span-6 text-[62px] leading-[1.03]\" data-hero=\"title\" data-kid=\"1-2-1-1-1\" data-name=\"hero headline text\">Their watch.<br data-kid=\"1-2-1-1-1-1\" data-name=\"line break in headline\"/>Your connection.</h1>\n<p class=\"col-span-4 col-start-9 pt-2 text-[16px] leading-[1.65] text-[#255E72]\" data-hero=\"aside\" data-kid=\"1-2-1-1-2\" data-name=\"hero intro description\">\n          SafeKid is a smartwatch concept for children aged 4–10, with twelve Vietnamese Zodiac editions and a parent-app concept alongside it.\n        </p>\n</div>\n<div class=\"relative -mt-20 flex justify-center\" data-kid=\"1-2-1-2\" data-name=\"hero watch image wrapper\">\n<div class=\"relative flex h-[600px] w-[620px] items-end justify-center\" data-kid=\"1-2-1-2-1\" data-name=\"hero watch image stage\">\n<span aria-hidden=\"true\" class=\"absolute bottom-4 h-[46px] w-[360px] rounded-[50%] bg-[#A9E7EA]/50 blur-[34px]\" data-kid=\"1-2-1-2-1-1\" data-name=\"decorative blurred shadow under watch\"></span>\n<img alt=\"The SafeKid smartwatch, Mouse edition\" class=\"relative mb-3 w-[540px] max-w-none drop-shadow-[0_30px_44px_rgba(21,90,102,0.18)]\" data-hero=\"product\" data-kid=\"1-2-1-2-1-2\" data-name=\"hero product watch image\" decoding=\"async\" src=\"/api/local/images/src/assets/figma/zodiac-collection-hero-watch.png\"/>\n</div>\n</div>\n<div class=\"-mt-6 border-t border-[#CBEAEC]\" data-kid=\"1-2-1-3\" data-name=\"hero spec bar with divider\">\n<dl class=\"grid grid-cols-3 divide-x divide-[#CBEAEC]\" data-kid=\"1-2-1-3-1\" data-name=\"hero fact triple grid\">\n<div class=\"py-6 pr-8\" data-kid=\"1-2-1-3-1-1\" data-name=\"fact block: designed for\">\n<dt class=\"text-[13px] text-[#5A818D]\" data-kid=\"1-2-1-3-1-1-1\" data-name=\"fact label: Designed for\">Designed for</dt>\n<dd class=\"mt-1 text-[15px] font-medium\" data-kid=\"1-2-1-3-1-1-2\" data-name=\"fact value: age range\">Children aged 4–10</dd>\n</div>\n<div class=\"px-8 py-6\" data-kid=\"1-2-1-3-1-2\" data-name=\"fact block: collection\">\n<dt class=\"text-[13px] text-[#5A818D]\" data-kid=\"1-2-1-3-1-2-1\" data-name=\"fact label: Collection\">Collection</dt>\n<dd class=\"mt-1 text-[15px] font-medium\" data-kid=\"1-2-1-3-1-2-2\" data-name=\"fact value: zodiac editions\">12 Vietnamese Zodiac editions</dd>\n</div>\n<div class=\"px-8 py-6\" data-kid=\"1-2-1-3-1-3\" data-name=\"fact block: alongside it\">\n<dt class=\"text-[13px] text-[#5A818D]\" data-kid=\"1-2-1-3-1-3-1\" data-name=\"fact label: Alongside it\">Alongside it</dt>\n<dd class=\"mt-1 text-[15px] font-medium\" data-kid=\"1-2-1-3-1-3-2\" data-name=\"fact value: parent app\">A parent-app concept</dd>\n</div>\n</dl>\n</div>\n<div class=\"flex items-center gap-6 pb-14\" data-hero=\"actions\" data-kid=\"1-2-1-4\" data-name=\"hero actions row\">\n<a class=\"pill bg-[#0B2B33] text-white hover:bg-[#124049]\" data-kid=\"1-2-1-4-1\" data-name=\"primary call-to-action pill button\" href=\"#reciprocal\">Explore the watch and app</a>\n<a class=\"linkarrow inline-flex items-center gap-2 text-[15px] font-medium\" data-kid=\"1-2-1-4-2\" data-name=\"secondary demo text link\" href=\"#demo\">Try the local demo <i aria-hidden=\"true\" class=\"icon-arrow-right arrow text-[16px]\" data-kid=\"1-2-1-4-2-1\" data-name=\"right arrow icon\"></i></a>\n<span class=\"text-[13px] text-[#5A818D]\" data-kid=\"1-2-1-4-3\" data-name=\"disclaimer: no watch connected\">No watch is connected.</span>\n</div>\n</div>\n</section>\n<!-- QUESTION -->\n<section class=\"bg-white py-[130px]\" data-kid=\"1-3\" data-name=\"question section\">\n<div class=\"mx-auto max-w-[1320px] px-8\" data-kid=\"1-3-1\" data-name=\"question section content\">\n<div class=\"grid grid-cols-12 gap-8\" data-kid=\"1-3-1-1\" data-name=\"question headline and copy grid\">\n<h2 class=\"display col-span-7 text-[52px] leading-[1.1]\" data-kid=\"1-3-1-1-1\" data-name=\"section heading question\">How do you give them more room without losing touch?</h2>\n<div class=\"col-span-4 col-start-9 pt-2\" data-kid=\"1-3-1-1-2\" data-name=\"question description wrapper\">\n<p class=\"text-[16px] leading-[1.7] text-[#255E72]\" data-kid=\"1-3-1-1-2-1\" data-name=\"section descriptive paragraph\">\n            SafeKid is designed for the years when a child starts walking to a friend's house alone. The watch stays on the wrist; the parent-app concept holds the other side of the same relationship.\n          </p>\n</div>\n</div>\n<p class=\"mt-16 text-[14px] font-medium text-[#255E72]\" data-kid=\"1-3-1-2\" data-name=\"section subheading label\">Watch and parent app</p>\n</div>\n</section>\n<!-- RECIPROCAL INSPECTION -->\n<section class=\"relative bg-[#F4FBFB]\" data-kid=\"1-4\" data-name=\"sticky scroll inspection section\" data-scene=\"\" id=\"reciprocal\" style=\"height:200vh\">\n<div class=\"sticky top-0 flex h-screen items-center overflow-hidden\" data-kid=\"1-4-1\" data-name=\"sticky viewport container\">\n<div class=\"mx-auto w-full max-w-[1320px] px-8\" data-kid=\"1-4-1-1\" data-name=\"inspection content wrapper\">\n<div class=\"flex items-center justify-between\" data-kid=\"1-4-1-1-1\" data-name=\"inspection controls row\">\n<div aria-label=\"Inspection views\" class=\"flex gap-2\" data-kid=\"1-4-1-1-1-1\" data-name=\"inspection view toggle group\" role=\"group\">\n<button aria-pressed=\"true\" class=\"viewbtn rounded-full border border-[#0B2B33]/20 px-4 py-2 text-[14px]\" data-dynamic=\"true\" data-kid=\"1-4-1-1-1-1-1\" data-name=\"view toggle button: Watch and app\" data-reason=\"aria-pressed toggled by script per active view state\" data-view=\"0\" type=\"button\">Watch and app</button>\n<button aria-pressed=\"false\" class=\"viewbtn rounded-full border border-[#0B2B33]/20 px-4 py-2 text-[14px]\" data-dynamic=\"true\" data-kid=\"1-4-1-1-1-1-2\" data-name=\"view toggle button: Calling\" data-reason=\"aria-pressed toggled by script per active view state\" data-view=\"1\" type=\"button\">Calling</button>\n<button aria-pressed=\"false\" class=\"viewbtn rounded-full border border-[#0B2B33]/20 px-4 py-2 text-[14px]\" data-dynamic=\"true\" data-kid=\"1-4-1-1-1-1-3\" data-name=\"view toggle button: Safe zones\" data-reason=\"aria-pressed toggled by script per active view state\" data-view=\"2\" type=\"button\">Safe zones</button>\n</div>\n<p class=\"text-[13px] text-[#4A7481]\" data-kid=\"1-4-1-1-1-2\" data-name=\"concept disclaimer caption\">Designed experience. Concept screens, no live connection.</p>\n</div>\n<div class=\"mt-10 grid grid-cols-[440px_1fr] items-center gap-16\" data-kid=\"1-4-1-1-2\" data-name=\"inspection grid with watch and panel\">\n<div class=\"relative flex h-[480px] items-center justify-center\" data-kid=\"1-4-1-1-2-1\" data-name=\"watch display stage\">\n<img alt=\"SafeKid watch, fixed for inspection\" class=\"w-[440px] max-w-none drop-shadow-[0_26px_36px_rgba(21,90,102,0.16)]\" data-kid=\"1-4-1-1-2-1-1\" data-name=\"inspection watch image\" decoding=\"async\" id=\"scene-watch\" src=\"/api/local/images/src/assets/figma/zodiac-collection-hero-watch.png\"/>\n<p class=\"absolute bottom-2 text-[14px] font-medium\" data-kid=\"1-4-1-1-2-1-2\" data-name=\"watch caption label\">Child's watch</p>\n</div>\n<div data-kid=\"1-4-1-1-2-2\" data-name=\"parent-app panel column\">\n<div class=\"relative h-[300px]\" data-kid=\"1-4-1-1-2-2-1\" data-name=\"swappable app panel container\" data-panels=\"\">\n<div class=\"appstate is-on\" data-kid=\"1-4-1-1-2-2-1-1\" data-name=\"app state panel: watch and app\" data-state=\"0\">\n<div class=\"rounded-[22px] bg-white p-7 shadow-[0_18px_40px_rgba(21,90,102,0.10)]\" data-kid=\"1-4-1-1-2-2-1-1-1\" data-name=\"concept card: location &amp; call\">\n<p class=\"text-[13px] font-medium text-[#255E72]\" data-kid=\"1-4-1-1-2-2-1-1-1-1\" data-name=\"card header label: Parent app concept\">Parent app concept</p>\n<div class=\"mt-4 flex items-center gap-3 rounded-[14px] bg-[#F0FBFB] px-4 py-3.5\" data-kid=\"1-4-1-1-2-2-1-1-1-2\" data-name=\"location feature row\">\n<i aria-hidden=\"true\" class=\"icon-map-pin text-[18px] text-[#255E72]\" data-kid=\"1-4-1-1-2-2-1-1-1-2-1\" data-name=\"map pin icon\"></i>\n<p class=\"text-[15px]\" data-kid=\"1-4-1-1-2-2-1-1-1-2-2\" data-name=\"location feature label\">Location view</p>\n</div>\n<div class=\"mt-2.5 flex items-center gap-3 rounded-[14px] bg-[#F0FBFB] px-4 py-3.5\" data-kid=\"1-4-1-1-2-2-1-1-1-3\" data-name=\"call feature row\">\n<i aria-hidden=\"true\" class=\"icon-phone text-[18px] text-[#255E72]\" data-kid=\"1-4-1-1-2-2-1-1-1-3-1\" data-name=\"phone icon\"></i>\n<p class=\"text-[15px]\" data-kid=\"1-4-1-1-2-2-1-1-1-3-2\" data-name=\"call feature label\">Call from the phone</p>\n</div>\n<p class=\"mt-4 text-[13px] leading-[1.5] text-[#5A818D]\" data-kid=\"1-4-1-1-2-2-1-1-1-4\" data-name=\"concept footnote\">Drawn only to show where information would appear.</p>\n</div>\n</div>\n<div class=\"appstate\" data-kid=\"1-4-1-1-2-2-1-2\" data-name=\"app state panel: calling\" data-state=\"1\">\n<div class=\"rounded-[22px] bg-white p-7 shadow-[0_18px_40px_rgba(21,90,102,0.10)]\" data-kid=\"1-4-1-1-2-2-1-2-1\" data-name=\"concept card: two-way calling\">\n<p class=\"text-[13px] font-medium text-[#255E72]\" data-kid=\"1-4-1-1-2-2-1-2-1-1\" data-name=\"card header label: Two-Way Calling\">Two-Way Calling — concept</p>\n<div class=\"mt-4 flex items-center gap-4 rounded-[14px] bg-[#F0FBFB] px-4 py-4\" data-kid=\"1-4-1-1-2-2-1-2-1-2\" data-name=\"call action row\">\n<span class=\"grid h-11 w-11 place-items-center rounded-full bg-white\" data-kid=\"1-4-1-1-2-2-1-2-1-2-1\" data-name=\"phone icon circle\"><i aria-hidden=\"true\" class=\"icon-phone text-[18px] text-[#255E72]\" data-kid=\"1-4-1-1-2-2-1-2-1-2-1-1\" data-name=\"phone icon\"></i></span>\n<div data-kid=\"1-4-1-1-2-2-1-2-1-2-2\" data-name=\"call action text group\">\n<p class=\"text-[15px] font-medium\" data-kid=\"1-4-1-1-2-2-1-2-1-2-2-1\" data-name=\"call action title\">Call the watch</p>\n<p class=\"text-[13px] text-[#4A7481]\" data-kid=\"1-4-1-1-2-2-1-2-1-2-2-2\" data-name=\"call action subtitle\">The parent side of the call.</p>\n</div>\n</div>\n<p class=\"mt-4 text-[15px] leading-[1.6] text-[#255E72]\" data-kid=\"1-4-1-1-2-2-1-2-1-3\" data-name=\"concept explanation text\">On the watch, the same call appears as one button on the screen. The design describes both ends; it does not place a call.</p>\n</div>\n</div>\n<div class=\"appstate\" data-dynamic=\"true\" data-kid=\"1-4-1-1-2-2-1-3\" data-name=\"app state panel: safe zones\" data-reason=\"class 'is-on' toggled by script to reveal active inspection panel\" data-state=\"2\">\n<div class=\"rounded-[22px] bg-white p-7 shadow-[0_18px_40px_rgba(21,90,102,0.10)]\" data-kid=\"1-4-1-1-2-2-1-3-1\" data-name=\"concept card: safe zone alerts\">\n<p class=\"text-[13px] font-medium text-[#255E72]\" data-kid=\"1-4-1-1-2-2-1-3-1-1\" data-name=\"card header label: Safe Zone Alerts\">Safe Zone Alerts — designed example</p>\n<div class=\"mt-4 flex flex-col gap-2.5\" data-kid=\"1-4-1-1-2-2-1-3-1-2\" data-name=\"sample zone list\">\n<div class=\"flex items-center justify-between rounded-[14px] bg-[#F0FBFB] px-4 py-3\" data-kid=\"1-4-1-1-2-2-1-3-1-2-1\" data-name=\"zone row: Home zone\">\n<span class=\"text-[15px]\" data-kid=\"1-4-1-1-2-2-1-3-1-2-1-1\" data-name=\"zone name: Home zone\">Home zone</span><span class=\"text-[13px] text-[#5A818D]\" data-kid=\"1-4-1-1-2-2-1-3-1-2-1-2\" data-name=\"zone description: named area\">A named area</span>\n</div>\n<div class=\"flex items-center justify-between rounded-[14px] bg-[#F0FBFB] px-4 py-3\" data-kid=\"1-4-1-1-2-2-1-3-1-2-2\" data-name=\"zone row: School zone\">\n<span class=\"text-[15px]\" data-kid=\"1-4-1-1-2-2-1-3-1-2-2-1\" data-name=\"zone name: School zone\">School zone</span><span class=\"text-[13px] text-[#5A818D]\" data-kid=\"1-4-1-1-2-2-1-3-1-2-2-2\" data-name=\"zone description: second example\">A second example</span>\n</div>\n</div>\n<p class=\"mt-4 text-[13px] leading-[1.5] text-[#5A818D]\" data-kid=\"1-4-1-1-2-2-1-3-1-3\" data-name=\"concept footnote\">A sample of how a zone might be described. No boundary, address or alert exists.</p>\n</div>\n</div>\n</div>\n<p class=\"mt-6 max-w-[420px] text-[15px] leading-[1.6] text-[#255E72]\" data-dynamic=\"true\" data-kid=\"1-4-1-1-2-2-2\" data-name=\"inspection description line\" data-reason=\"text replaced by script for each inspection view\" data-scene-line=\"\">\n              Two participants, one product. The watch carries the actions; the app is where a parent sees them.\n            </p>\n</div>\n</div>\n</div>\n</div>\n</section>\n<p class=\"mx-auto max-w-[1320px] px-8 py-8 text-[14px] text-[#5A818D]\" data-dynamic=\"true\" data-kid=\"1-5\" data-name=\"summary paragraph below inspection\" data-reason=\"text replaced by script for each inspection view\">\n    In short: the concept pairs one watch with one phone. Calling runs both ways; location information and safe-zone notices move toward the parent. Nothing on this page is paired to hardware.\n  </p>\n<!-- CAPABILITIES -->\n<section class=\"bg-white py-[120px]\" data-kid=\"1-6\" data-name=\"capabilities section\" id=\"capabilities\">\n<div class=\"mx-auto grid max-w-[1320px] grid-cols-[240px_1fr] gap-16 px-8\" data-kid=\"1-6-1\" data-name=\"capabilities two-column grid\">\n<div data-kid=\"1-6-1-1\" data-name=\"capabilities sticky heading column\">\n<h2 class=\"display text-[34px] leading-[1.14]\" data-kid=\"1-6-1-1-1\" data-name=\"section heading: Designed capabilities\">Designed capabilities</h2>\n<p class=\"mt-4 text-[14px] leading-[1.6] text-[#5A818D]\" data-kid=\"1-6-1-1-2\" data-name=\"section sub note\">Not live services. Only the SOS simulation and the chat screen run on this site.</p>\n</div>\n<div data-kid=\"1-6-1-2\" data-name=\"capabilities list column\">\n<div class=\"grid grid-cols-[1fr_1.25fr] items-baseline gap-10 border-t border-[#D7EDEF] py-7\" data-kid=\"1-6-1-2-1\" data-name=\"capability row: Real-Time GPS\">\n<p class=\"text-[21px] font-semibold tracking-[-.01em]\" data-kid=\"1-6-1-2-1-1\" data-name=\"capability name: Real-Time GPS Tracking\">Real-Time GPS Tracking</p>\n<p class=\"text-[16px] leading-[1.65] text-[#255E72]\" data-kid=\"1-6-1-2-1-2\" data-name=\"capability description\">Location information taken from the watch and shown in the parent-app view.</p>\n</div>\n<div class=\"grid grid-cols-[1fr_1.25fr] items-baseline gap-10 border-t border-[#D7EDEF] py-7\" data-kid=\"1-6-1-2-2\" data-name=\"capability row: Two-Way Calling\">\n<p class=\"text-[21px] font-semibold tracking-[-.01em]\" data-kid=\"1-6-1-2-2-1\" data-name=\"capability name: Two-Way Calling\">Two-Way Calling</p>\n<p class=\"text-[16px] leading-[1.65] text-[#255E72]\" data-kid=\"1-6-1-2-2-2\" data-name=\"capability description\">A call in both directions, between the watch and the phone.</p>\n</div>\n<div class=\"border-t border-[#D7EDEF] py-8\" data-kid=\"1-6-1-2-3\" data-name=\"capability row: SOS feature block\">\n<div class=\"grid grid-cols-[1fr_1.25fr] items-start gap-10\" data-kid=\"1-6-1-2-3-1\" data-name=\"feature row wrapper\">\n<p class=\"text-[23px] font-semibold tracking-[-.01em]\" data-kid=\"1-6-1-2-3-1-1\" data-name=\"capability name: One-Touch SOS Button\">One-Touch SOS Button</p>\n<div data-kid=\"1-6-1-2-3-1-2\" data-name=\"feature details wrapper\">\n<p class=\"text-[16px] leading-[1.65] text-[#255E72]\" data-kid=\"1-6-1-2-3-1-2-1\" data-name=\"feature description\">One press on the watch is the intended alert path. The website offers a local simulation only, which acknowledges the press and contacts nobody.</p>\n<a class=\"linkarrow mt-3 inline-flex items-center gap-2 text-[14px] font-medium text-[#0B2B33]\" data-kid=\"1-6-1-2-3-1-2-2\" data-name=\"feature simulation link\" href=\"#demo\">Open the SOS simulation <i aria-hidden=\"true\" class=\"icon-arrow-right arrow text-[15px]\" data-kid=\"1-6-1-2-3-1-2-2-1\" data-name=\"right arrow icon\"></i></a>\n</div>\n</div>\n</div>\n<div class=\"grid grid-cols-[1fr_1.25fr] items-baseline gap-10 border-t border-[#D7EDEF] py-7\" data-kid=\"1-6-1-2-4\" data-name=\"capability row: Safe Zone Alerts\">\n<p class=\"text-[21px] font-semibold tracking-[-.01em]\" data-kid=\"1-6-1-2-4-1\" data-name=\"capability name: Safe Zone Alerts\">Safe Zone Alerts</p>\n<p class=\"text-[16px] leading-[1.65] text-[#255E72]\" data-kid=\"1-6-1-2-4-2\" data-name=\"capability description\">A named area around home or school that can raise a notice in the concept.</p>\n</div>\n<div class=\"grid grid-cols-[1fr_1.25fr] items-baseline gap-10 border-t border-[#D7EDEF] py-7\" data-kid=\"1-6-1-2-5\" data-name=\"capability row: Habit &amp; Reward\">\n<p class=\"text-[21px] font-semibold tracking-[-.01em]\" data-kid=\"1-6-1-2-5-1\" data-name=\"capability name: Habit &amp; Reward System\">Habit &amp; Reward System</p>\n<p class=\"text-[16px] leading-[1.65] text-[#255E72]\" data-kid=\"1-6-1-2-5-2\" data-name=\"capability description\">Daily routines the child completes, with a reward shown on the watch.</p>\n</div>\n<div class=\"grid grid-cols-[1fr_1.25fr] items-baseline gap-10 border-y border-[#D7EDEF] py-7\" data-kid=\"1-6-1-2-6\" data-name=\"capability row: Long Battery Life\">\n<p class=\"text-[21px] font-semibold tracking-[-.01em]\" data-kid=\"1-6-1-2-6-1\" data-name=\"capability name: Long Battery Life\">Long Battery Life</p>\n<p class=\"text-[16px] leading-[1.65] text-[#255E72]\" data-kid=\"1-6-1-2-6-2\" data-name=\"capability description\">A stated design goal. No runtime figure is claimed.</p>\n</div>\n</div>\n</div>\n</section>\n<!-- EDITIONS -->\n<section class=\"bg-[#EAFBFB] py-[120px]\" data-kid=\"1-7\" data-name=\"editions section\" id=\"editions\">\n<div class=\"mx-auto max-w-[1320px] px-8\" data-kid=\"1-7-1\" data-name=\"editions content wrapper\">\n<div class=\"grid grid-cols-12 items-end gap-8\" data-kid=\"1-7-1-1\" data-name=\"editions heading grid\">\n<h2 class=\"display col-span-6 text-[44px] leading-[1.1]\" data-kid=\"1-7-1-1-1\" data-name=\"section heading: Choose collection\">Choose from the whole collection.</h2>\n<p class=\"col-span-4 col-start-9 text-[15px] leading-[1.6] text-[#4A7481]\" data-kid=\"1-7-1-1-2\" data-name=\"section description\">All twelve editions, side by side. Select one to see it larger and open its page.</p>\n</div>\n<div class=\"mt-12 flex items-end justify-between gap-10\" data-kid=\"1-7-1-2\" data-name=\"editions preview layout\">\n<div class=\"relative h-[360px] w-[360px]\" data-dynamic=\"true\" data-kid=\"1-7-1-2-1\" data-name=\"zodiac image stack\" data-reason=\"stacked image layers; visibility toggled by script to reveal selected edition\">\n<img alt=\"\" class=\"edimg is-active\" data-edition-img=\"rat\" data-kid=\"1-7-1-2-1-1\" data-name=\"stacked edition image: rat\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/rat.png\"/>\n<img alt=\"\" class=\"edimg\" data-edition-img=\"buffalo\" data-kid=\"1-7-1-2-1-2\" data-name=\"stacked edition image: buffalo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/buffalo.png\"/>\n<img alt=\"\" class=\"edimg\" data-edition-img=\"tiger\" data-kid=\"1-7-1-2-1-3\" data-name=\"stacked edition image: tiger\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/tiger.png\"/>\n<img alt=\"\" class=\"edimg\" data-edition-img=\"cat\" data-kid=\"1-7-1-2-1-4\" data-name=\"stacked edition image: cat\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/cat.png\"/>\n<img alt=\"\" class=\"edimg\" data-edition-img=\"dragon\" data-kid=\"1-7-1-2-1-5\" data-name=\"stacked edition image: dragon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/dragon.png\"/>\n<img alt=\"\" class=\"edimg\" data-edition-img=\"snake\" data-kid=\"1-7-1-2-1-6\" data-name=\"stacked edition image: snake\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/snake.png\"/>\n<img alt=\"\" class=\"edimg\" data-edition-img=\"horse\" data-kid=\"1-7-1-2-1-7\" data-name=\"stacked edition image: horse\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/horse.png\"/>\n<img alt=\"\" class=\"edimg\" data-edition-img=\"sheep\" data-kid=\"1-7-1-2-1-8\" data-name=\"stacked edition image: sheep\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/sheep.png\"/>\n<img alt=\"\" class=\"edimg\" data-edition-img=\"monkey\" data-kid=\"1-7-1-2-1-9\" data-name=\"stacked edition image: monkey\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/monkey.png\"/>\n<img alt=\"\" class=\"edimg\" data-edition-img=\"rooster\" data-kid=\"1-7-1-2-1-10\" data-name=\"stacked edition image: rooster\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/rooster.png\"/>\n<img alt=\"\" class=\"edimg\" data-edition-img=\"dog\" data-kid=\"1-7-1-2-1-11\" data-name=\"stacked edition image: dog\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/dog.png\"/>\n<img alt=\"\" class=\"edimg\" data-edition-img=\"pig\" data-kid=\"1-7-1-2-1-12\" data-name=\"stacked edition image: pig\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/pig.png\"/>\n</div>\n<div class=\"max-w-[380px]\" data-kid=\"1-7-1-2-2\" data-name=\"editions info column\">\n<p class=\"display text-[30px] leading-[1.15]\" data-dynamic=\"true\" data-kid=\"1-7-1-2-2-1\" data-name=\"edition English name heading\" data-reason=\"English name text replaced by script per selected edition\"><span data-current-label=\"\" data-dynamic=\"true\" data-kid=\"1-7-1-2-2-1-1\" data-name=\"edition name: Mouse\" data-reason=\"text replaced by script for current selection\">Mouse</span> edition</p>\n<p c