ata-kid=\"1-6-1-2-2-1-6\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/snake.png\"/>\n<img alt=\"\" class=\"edimg\" data-edition-img=\"horse\" data-kid=\"1-6-1-2-2-1-7\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/horse.png\"/>\n<img alt=\"\" class=\"edimg\" data-edition-img=\"sheep\" data-kid=\"1-6-1-2-2-1-8\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/sheep.png\"/>\n<img alt=\"\" class=\"edimg\" data-edition-img=\"monkey\" data-kid=\"1-6-1-2-2-1-9\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/monkey.png\"/>\n<img alt=\"\" class=\"edimg\" data-edition-img=\"rooster\" data-kid=\"1-6-1-2-2-1-10\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/rooster.png\"/>\n<img alt=\"\" class=\"edimg\" data-edition-img=\"dog\" data-kid=\"1-6-1-2-2-1-11\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/dog.png\"/>\n<img alt=\"\" class=\"edimg\" data-edition-img=\"pig\" data-kid=\"1-6-1-2-2-1-12\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/pig.png\"/>\n</div>\n<div class=\"mt-2 flex items-end justify-between\" data-kid=\"1-6-1-2-2-2\">\n<div data-kid=\"1-6-1-2-2-2-1\">\n<p class=\"text-[20px] font-semibold tracking-[-.01em]\" data-kid=\"1-6-1-2-2-2-1-1\"><span data-current-label=\"\" data-kid=\"1-6-1-2-2-2-1-1-1\">Mouse</span> edition</p>\n<p class=\"text-[14px] text-[#4A7481]\" data-kid=\"1-6-1-2-2-2-1-2\">Vietnamese Zodiac: <span data-current-vi=\"\" data-kid=\"1-6-1-2-2-2-1-2-1\">Tý</span></p>\n</div>\n<a class=\"pill border border-[#0B2B33]/20 text-[14px] hover:border-[#0B2B33]\" data-current-link=\"\" data-kid=\"1-6-1-2-2-2-2\" href=\"#/product/rat\"><span data-current-action=\"\" data-kid=\"1-6-1-2-2-2-2-1\">View Mouse edition</span></a>\n</div>\n</div>\n<ul aria-label=\"Editions, second six\" class=\"flex flex-col gap-0.5\" data-kid=\"1-6-1-2-3\" id=\"edition-list-right\">\n<li data-kid=\"1-6-1-2-3-1\"><button class=\"edname flex w-full items-center gap-3 py-2.5 text-[17px] text-[#255E72] hover:text-[#0B2B33]\" data-edition=\"horse\" data-kid=\"1-6-1-2-3-1-1\" data-label=\"Pony\" data-vi=\"Ngọ\" type=\"button\"><span class=\"dot inline-block h-1.5 w-1.5 rounded-full bg-[#00C7CA]\" data-kid=\"1-6-1-2-3-1-1-1\"></span>Pony<span class=\"text-[13px] text-[#5A818D]\" data-kid=\"1-6-1-2-3-1-1-2\">Ngọ</span></button></li>\n<li data-kid=\"1-6-1-2-3-2\"><button class=\"edname flex w-full items-center gap-3 py-2.5 text-[17px] text-[#255E72] hover:text-[#0B2B33]\" data-edition=\"sheep\" data-kid=\"1-6-1-2-3-2-1\" data-label=\"Sheep\" data-vi=\"Mùi\" type=\"button\"><span class=\"dot inline-block h-1.5 w-1.5 rounded-full bg-[#00C7CA]\" data-kid=\"1-6-1-2-3-2-1-1\"></span>Sheep<span class=\"text-[13px] text-[#5A818D]\" data-kid=\"1-6-1-2-3-2-1-2\">Mùi</span></button></li>\n<li data-kid=\"1-6-1-2-3-3\"><button class=\"edname flex w-full items-center gap-3 py-2.5 text-[17px] text-[#255E72] hover:text-[#0B2B33]\" data-edition=\"monkey\" data-kid=\"1-6-1-2-3-3-1\" data-label=\"Monkey\" data-vi=\"Thân\" type=\"button\"><span class=\"dot inline-block h-1.5 w-1.5 rounded-full bg-[#00C7CA]\" data-kid=\"1-6-1-2-3-3-1-1\"></span>Monkey<span class=\"text-[13px] text-[#5A818D]\" data-kid=\"1-6-1-2-3-3-1-2\">Thân</span></button></li>\n<li data-kid=\"1-6-1-2-3-4\"><button class=\"edname flex w-full items-center gap-3 py-2.5 text-[17px] text-[#255E72] hover:text-[#0B2B33]\" data-edition=\"rooster\" data-kid=\"1-6-1-2-3-4-1\" data-label=\"Chick\" data-vi=\"Dậu\" type=\"button\"><span class=\"dot inline-block h-1.5 w-1.5 rounded-full bg-[#00C7CA]\" data-kid=\"1-6-1-2-3-4-1-1\"></span>Chick<span class=\"text-[13px] text-[#5A818D]\" data-kid=\"1-6-1-2-3-4-1-2\">Dậu</span></button></li>\n<li data-kid=\"1-6-1-2-3-5\"><button class=\"edname flex w-full items-center gap-3 py-2.5 text-[17px] text-[#255E72] hover:text-[#0B2B33]\" data-edition=\"dog\" data-kid=\"1-6-1-2-3-5-1\" data-label=\"Puppy\" data-vi=\"Tuất\" type=\"button\"><span class=\"dot inline-block h-1.5 w-1.5 rounded-full bg-[#00C7CA]\" data-kid=\"1-6-1-2-3-5-1-1\"></span>Puppy<span class=\"text-[13px] text-[#5A818D]\" data-kid=\"1-6-1-2-3-5-1-2\">Tuất</span></button></li>\n<li data-kid=\"1-6-1-2-3-6\"><button class=\"edname flex w-full items-center gap-3 py-2.5 text-[17px] text-[#255E72] hover:text-[#0B2B33]\" data-edition=\"pig\" data-kid=\"1-6-1-2-3-6-1\" data-label=\"Piggy\" data-vi=\"Hợi\" type=\"button\"><span class=\"dot inline-block h-1.5 w-1.5 rounded-full bg-[#00C7CA]\" data-kid=\"1-6-1-2-3-6-1-1\"></span>Piggy<span class=\"text-[13px] text-[#5A818D]\" data-kid=\"1-6-1-2-3-6-1-2\">Hợi</span></button></li>\n</ul>\n</div>\n<div class=\"mt-12 flex items-center justify-between border-t border-[#CBE9EA] pt-6\" data-kid=\"1-6-1-3\">\n<p class=\"text-[13px] text-[#4A7481]\" data-kid=\"1-6-1-3-1\">12 editions. One SafeKid concept. No prices or availability are shown.</p>\n<a class=\"linkarrow inline-flex items-center gap-2 text-[14px] font-medium\" data-kid=\"1-6-1-3-2\" href=\"#/zodiac\">Open the collection page <i aria-hidden=\"true\" class=\"icon-arrow-right arrow text-[15px]\" data-kid=\"1-6-1-3-2-1\"></i></a>\n</div>\n<p aria-live=\"polite\" class=\"sr-only\" data-kid=\"1-6-1-4\" data-live=\"\"></p>\n</div>\n</section>\n<!-- PROTOTYPES -->\n<section class=\"bg-[#0B2B33] py-[130px] text-white\" data-kid=\"1-7\" id=\"prototypes\">\n<div class=\"mx-auto max-w-[1320px] px-8\" data-kid=\"1-7-1\">\n<div class=\"grid grid-cols-12 items-end gap-8\" data-kid=\"1-7-1-1\">\n<h2 class=\"display col-span-6 text-[46px] leading-[1.1] text-[#F2FEFE]\" data-kid=\"1-7-1-1-1\">Try what exists.</h2>\n<p class=\"col-span-5 col-start-8 text-[15px] leading-[1.6] text-[#B7F2F2]\" data-kid=\"1-7-1-1-2\">\n          A local pairing demonstration, then the two prototypes that actually run on this site. Nothing here connects to hardware.\n        </p>\n</div>\n<div class=\"mt-14 rounded-[26px] border border-white/15 p-8\" data-kid=\"1-7-1-2\">\n<div class=\"grid grid-cols-2 gap-10\" data-kid=\"1-7-1-2-1\">\n<div data-kid=\"1-7-1-2-1-1\">\n<p class=\"flex items-center gap-2 text-[13px] font-medium text-[#8FD3D8]\" data-kid=\"1-7-1-2-1-1-1\"><i aria-hidden=\"true\" class=\"icon-watch text-[15px]\" data-kid=\"1-7-1-2-1-1-1-1\"></i> Sample watch</p>\n<div class=\"mt-5 flex items-center gap-5\" data-kid=\"1-7-1-2-1-1-2\">\n<img alt=\"Sample SafeKid watch\" class=\"h-28 w-28 object-contain\" data-kid=\"1-7-1-2-1-1-2-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/rat.png\"/>\n<div data-kid=\"1-7-1-2-1-1-2-2\">\n<p class=\"text-[17px] font-medium\" data-kid=\"1-7-1-2-1-1-2-2-1\">Mouse edition</p>\n<p class=\"mt-1 max-w-[220px] text-[13px] leading-[1.5] text-[#9FDDE2]\" data-kid=\"1-7-1-2-1-1-2-2-2\">A sample edition used only for this demonstration.</p>\n</div>\n</div>\n<button class=\"mt-6 rounded-full bg-white px-5 py-2.5 text-[14px] font-medium text-[#0B2B33] transition-colors hover:bg-[#EAFBFB]\" data-kid=\"1-7-1-2-1-1-3\" data-select-watch=\"\" type=\"button\">Select sample watch</button>\n</div>\n<div data-kid=\"1-7-1-2-1-2\">\n<p class=\"flex items-center gap-2 text-[13px] font-medium text-[#8FD3D8]\" data-kid=\"1-7-1-2-1-2-1\"><i aria-hidden=\"true\" class=\"icon-smartphone text-[15px]\" data-kid=\"1-7-1-2-1-2-1-1\"></i> Parent-app demo</p>\n<div class=\"mt-5 rounded-[16px] bg-white/8 px-5 py-4\" data-kid=\"1-7-1-2-1-2-2\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-7-1-2-1-2-2-1\">\n<i aria-hidden=\"true\" class=\"icon-phone text-[17px] text-[#B7F2F2]\" data-kid=\"1-7-1-2-1-2-2-1-1\"></i>\n<p class=\"text-[15px]\" data-kid=\"1-7-1-2-1-2-2-1-2\">Call the sample watch</p>\n</div>\n<p class=\"mt-2 text-[13px] leading-[1.5] text-[#9FDDE2]\" data-kid=\"1-7-1-2-1-2-2-2\">The pairing state is local to this page. No device, account or network request is involved.</p>\n</div>\n<div class=\"mt-4 flex items-center gap-3\" data-kid=\"1-7-1-2-1-2-3\">\n<button class=\"rounded-full bg-[#00C7CA] px-5 py-2.5 text-[14px] font-medium text-[#04262E] transition-opacity disabled:cursor-not-allowed disabled:opacity-35\" data-confirm-pairing=\"\" data-kid=\"1-7-1-2-1-2-3-1\" disabled=\"\" type=\"button\">Confirm demo pairing</button>\n<button class=\"inline-flex items-center gap-2 rounded-full px-3 py-2.5 text-[13px] text-[#9FDDE2] hover:text-white\" data-kid=\"1-7-1-2-1-2-3-2\" data-reset-pairing=\"\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-rotate-ccw text-[14px]\" data-kid=\"1-7-1-2-1-2-3-2-1\"></i> Reset demo</button>\n</div>\n</div>\n</div>\n<p aria-live=\"polite\" class=\"mt-7 text-[14px] text-[#8FD3D8]\" data-kid=\"1-7-1-2-2\" data-pairing-result=\"\" role=\"status\">Not started. Select the sample watch to begin.</p>\n</div>\n<div class=\"mt-10\" data-kid=\"1-7-1-3\">\n<div class=\"flex items-center justify-between border-t border-white/15 py-6\" data-kid=\"1-7-1-3-1\">\n<div class=\"flex items-baseline gap-8\" data-kid=\"1-7-1-3-1-1\">\n<p class=\"w-[240px] text-[17px] font-medium\" data-kid=\"1-7-1-3-1-1-1\">SOS simulation</p>\n<p class=\"max-w-[420px] text-[14px] leading-[1.55] text-[#9FDDE2]\" data-kid=\"1-7-1-3-1-1-2\">A local screen that acknowledges a press. No alert, call or location is sent.</p>\n</div>\n<a class=\"linkarrow inline-flex items-center gap-2 text-[14px] text-white\" data-kid=\"1-7-1-3-1-2\" href=\"#/sos\">Open SOS simulation <i aria-hidden=\"true\" class=\"icon-arrow-right arrow text-[15px]\" data-kid=\"1-7-1-3-1-2-1\"></i></a>\n</div>\n<div class=\"flex items-center justify-between border-t border-white/15 py-6\" data-kid=\"1-7-1-3-2\">\n<div class=\"flex items-baseline gap-8\" data-kid=\"1-7-1-3-2-1\">\n<p class=\"w-[240px] text-[17px] font-medium\" data-kid=\"1-7-1-3-2-1-1\">S.F AI chat prototype</p>\n<p class=\"max-w-[420px] text-[14px] leading-[1.55] text-[#9FDDE2]\" data-kid=\"1-7-1-3-2-1-2\">A chat screen from the design. Messages are not sent, and it is not emergency support.</p>\n</div>\n<a class=\"linkarrow inline-flex items-center gap-2 text-[14px] text-white\" data-kid=\"1-7-1-3-2-2\" href=\"#/chat\">Open the chat prototype <i aria-hidden=\"true\" class=\"icon-arrow-right arrow text-[15px]\" data-kid=\"1-7-1-3-2-2-1\"></i></a>\n</div>\n<div class=\"flex items-center justify-between border-y border-white/15 py-6\" data-kid=\"1-7-1-3-3\">\n<div class=\"flex items-baseline gap-8\" data-kid=\"1-7-1-3-3-1\">\n<p class=\"w-[240px] text-[17px] font-medium\" data-kid=\"1-7-1-3-3-1-1\"><span data-current-label=\"\" data-kid=\"1-7-1-3-3-1-1-1\">Mouse</span> edition details</p>\n<p class=\"max-w-[420px] text-[14px] leading-[1.55] text-[#9FDDE2]\" data-kid=\"1-7-1-3-3-1-2\">The edition page from the design template. Not a connected-device test.</p>\n</div>\n<a class=\"linkarrow inline-flex items-center gap-2 text-[14px] text-white\" data-current-link=\"\" data-kid=\"1-7-1-3-3-2\" href=\"#/product/rat\">View details <i aria-hidden=\"true\" class=\"icon-arrow-right arrow text-[15px]\" data-kid=\"1-7-1-3-3-2-1\"></i></a>\n</div>\n</div>\n</div>\n</section>\n<!-- CREDIT + CLOSING -->\n<section class=\"bg-white pb-20 pt-[110px]\" data-kid=\"1-8\">\n<div class=\"mx-auto max-w-[1320px] px-8\" data-kid=\"1-8-1\">\n<p class=\"text-[13px] text-[#5A818D]\" data-kid=\"1-8-1-1\">Developed by <span class=\"font-medium text-[#255E72]\" data-kid=\"1-8-1-1-1\">DigiBabi</span></p>\n<div class=\"mt-14 grid grid-cols-12 items-center gap-8\" data-kid=\"1-8-1-2\">\n<h2 class=\"display col-span-6 text-[46px] leading-[1.1]\" data-kid=\"1-8-1-2-1\">Which one feels like theirs?</h2>\n<div class=\"col-span-5 col-start-8\" data-kid=\"1-8-1-2-2\">\n<div class=\"flex items-center gap-6\" data-kid=\"1-8-1-2-2-1\">\n<img alt=\"Selected SafeKid edition\" class=\"h-[120px] w-[120px] object-contain\" data-closing-img=\"\" data-kid=\"1-8-1-2-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/rat.png\"/>\n<div data-kid=\"1-8-1-2-2-1-2\">\n<p class=\"text-[18px] font-medium\" data-kid=\"1-8-1-2-2-1-2-1\"><span data-current-label=\"\" data-kid=\"1-8-1-2-2-1-2-1-1\">Mouse</span> edition</p>\n<p class=\"text-[14px] text-[#4A7481]\" data-kid=\"1-8-1-2-2-1-2-2\">Vietnamese Zodiac: <span data-current-vi=\"\" data-kid=\"1-8-1-2-2-1-2-2-1\">Tý</span></p>\n<div class=\"mt-4 flex items-center gap-5\" data-kid=\"1-8-1-2-2-1-2-3\">\n<a class=\"pill bg-[#0B2B33] text-white hover:bg-[#124049]\" data-current-link=\"\" data-kid=\"1-8-1-2-2-1-2-3-1\" href=\"#/product/rat\"><span data-current-action=\"\" data-kid=\"1-8-1-2-2-1-2-3-1-1\">View Mouse edition</span></a>\n<a class=\"linkarrow inline-flex items-center gap-2 text-[14px] font-medium\" data-kid=\"1-8-1-2-2-1-2-3-2\" href=\"#/contact\">Ask about SafeKid <i aria-hidden=\"true\" class=\"icon-arrow-right arrow text-[15px]\" data-kid=\"1-8-1-2-2-1-2-3-2-1\"></i></a>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- FOOTER -->\n<footer class=\"bg-[#F4FBFB] pt-14\" data-kid=\"1-9\">\n<div class=\"mx-auto max-w-[1320px] px-8\" data-kid=\"1-9-1\">\n<div class=\"flex items-start justify-between gap-12 pb-12\" data-kid=\"1-9-1-1\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-9-1-1-1\">\n<img alt=\"\" class=\"h-8 w-8 object-contain\" data-kid=\"1-9-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/brand/Logo_SafeKid.png\"/>\n<div data-kid=\"1-9-1-1-1-2\">\n<p class=\"display text-[16px] font-bold\" data-kid=\"1-9-1-1-1-2-1\">SafeKid</p>\n<p class=\"text-[13px] text-[#4A7481]\" data-kid=\"1-9-1-1-1-2-2\">Inspired by the Vietnamese Zodiac.</p>\n</div>\n</div>\n<nav aria-label=\"Footer\" class=\"grid grid-cols-3 gap-x-16 gap-y-2 text-[14px] text-[#255E72]\" data-kid=\"1-9-1-1-2\">\n<a class=\"hover:text-[#0B2B33]\" data-kid=\"1-9-1-1-2-1\" href=\"#top\">Home</a>\n<a class=\"hover:text-[#0B2B33]\" data-kid=\"1-9-1-1-2-2\" href=\"#/zodiac\">Zodiac Collection</a>\n<a class=\"hover:text-[#0B2B33]\" data-kid=\"1-9-1-1-2-3\" href=\"#/support\">Support</a>\n<a class=\"hover:text-[#0B2B33]\" data-kid=\"1-9-1-1-2-4\" href=\"#features\">Capabilities</a>\n<a class=\"hover:text-[#0B2B33]\" data-kid=\"1-9-1-1-2-5\" href=\"#/about\">About</a>\n<a class=\"hover:text-[#0B2B33]\" data-kid=\"1-9-1-1-2-6\" href=\"#/contact\">Contact</a>\n<a class=\"hover:text-[#0B2B33]\" data-kid=\"1-9-1-1-2-7\" href=\"#/sos\">SOS simulation</a>\n<a class=\"hover:text-[#0B2B33]\" data-kid=\"1-9-1-1-2-8\" href=\"#/chat\">S.F AI prototype</a>\n<a class=\"hover:text-[#0B2B33]\" data-kid=\"1-9-1-1-2-9\" href=\"mailto:support@safekid.com\">support@safekid.com</a>\n</nav>\n</div>\n<div class=\"flex items-center justify-between border-t border-[#D7EDEF] py-5 text-[13px] text-[#5A818D]\" data-kid=\"1-9-1-2\">\n<p data-kid=\"1-9-1-2-1\">© 2026 SafeKid. Concept site for demonstration.</p>\n<p data-kid=\"1-9-1-2-2\">Developed by DigiBabi</p>\n</div>\n</div>\n</footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\"></script>\n<script>\n(function(){\n  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n  if (window.gsap && window.ScrollTrigger) gsap.registerPlugin(ScrollTrigger);\n\n  /* ---------- edition selector ---------- */\n  var buttons = Array.prototype.slice.call(document.querySelectorAll('[data-edition]'));\n  var stack = Array.prototype.slice.call(document.querySelectorAll('[data-edition-img]'));\n  var closingImg = document.querySelector('[data-closing-img]');\n  var live = document.querySelector('[data-live]');\n  var committed = 'rat', preview = null;\n\n  function paint(id, announce){\n    stack.forEach(function(img){ img.classList.toggle('is-active', img.getAttribute('data-edition-img') === id); });\n    var btn = buttons.filter(function(b){ return b.getAttribute('data-edition') === id; })[0];\n    if (!btn) return;\n    var label = btn.getAttribute('data-label'), vi = btn.getAttribute('data-vi');\n    document.querySelectorAll('[data-current-label]').forEach(function(el){ el.textContent = label; });\n    document.querySelectorAll('[data-current-vi]').forEach(function(el){ el.textContent = vi; });\n    document.querySelectorAll('[data-current-action]').forEach(function(el){ el.textContent = 'View ' + label + ' edition'; });\n    document.querySelectorAll('[data-current-link]').forEach(function(el){\n      el.setAttribute('href', '#/product/' + id);\n      el.setAttribute('aria-label', 'View ' + label + ' edition details');\n    });\n    if (closingImg) closingImg.src = '/api/local/images/src/assets/products/' + id + '.png';\n    buttons.forEach(function(b){ b.setAttribute('aria-current', b.getAttribute('data-edition') === id ? 'true' : 'false'); });\n    if (announce && live) live.textContent = label + ' edition selected.';\n  }\n\n  buttons.forEach(function(btn){\n    var id = btn.getAttribute('data-edition');\n    btn.addEventListener('mouseenter', function(){ preview = id; paint(id, false); });\n    btn.addEventListener('focus', function(){ preview = id; paint(id, false); });\n    btn.addEventListener('click', function(){ committed = id; preview = null; paint(id, true); });\n  });\n  ['edition-list-left','edition-list-right'].forEach(function(listId){\n    var list = document.getElementById(listId);\n    if (!list) return;\n    list.addEventListener('mouseleave', function(){\n      if (preview !== null) { preview = null; paint(committed, false); }\n    });\n  });\n  paint(committed, false);\n\n  /* ---------- local pairing demo ---------- */\n  var selected = false, paired = false;\n  var selBtn = document.querySelector('[data-select-watch]');\n  var confBtn = document.querySelector('[data-confirm-pairing]');\n  var resetBtn = document.querySelector('[data-reset-pairing]');\n  var result = document.querySelector('[data-pairing-result]');\n\n  function pairingUI(){\n    if (!selBtn || !confBtn || !result) return;\n    selBtn.textContent = selected ? 'Sample watch selected' : 'Select sample watch';\n    selBtn.classList.toggle('bg-white', !selected);\n    selBtn.classList.toggle('bg-[#00C7CA]', selected);\n    selBtn.classList.toggle('text-[#04262E]', selected);\n    confBtn.disabled = !selected;\n    if (paired) result.textContent = 'Pairing demonstration complete. No real watch is connected.';\n    else if (selected) result.textContent = 'Sample watch selected. Nothing is paired yet.';\n    else result.textContent = 'Not started. Select the sample watch to begin.';\n  }\n  if (selBtn) selBtn.addEventListener('click', function(){ if (!paired) { selected = true; pairingUI(); } });\n  if (confBtn) confBtn.addEventListener('click', function(){ if (selected) { paired = true; pairingUI(); } });\n  if (resetBtn) resetBtn.addEventListener('click', function(){ selected = false; paired = false; pairingUI(); });\n  pairingUI();\n\n  /* ---------- motion ---------- */\n  var mm = window.gsap ? gsap.matchMedia() : null;\n  if (!mm) return;\n\n  mm.add({ reduce: '(prefers-reduced-motion: reduce)', motion: '(prefers-reduced-motion: no-preference)' }, function(ctx){\n    var isReduced = ctx.conditions.reduce;\n\n    if (isReduced) {\n      gsap.set('[data-story-watch]', { xPercent: -40, scale: .72 });\n      gsap.set('[data-story-app]', { opacity: 1, y: 0 });\n      gsap.set('[data-story-line]', { scaleX: 1 });\n      gsap.set('[data-story-copy-a]', { opacity: 0 });\n      gsap.set('[data-story-copy-b]', { opacity: 1 });\n      return;\n    }\n\n    /* hero entrance: product first, then language. Transform only, so the\n       composition is legible even if an animation never runs. */\n    var intro = gsap.timeline({ defaults: { ease: 'power3.out' } });\n    intro.from('[data-hero=\"product\"]', { y: 36, scale: .94, duration: 1.0 })\n         .from('[data-hero=\"title\"]', { y: 22, duration: .9 }, '-=.55')\n         .from('[data-hero=\"aside\"]', { y: 16, duration: .8 }, '-=.6');\n\n    /* hero product settles as the interlude arrives */\n    gsap.to('[data-hero=\"product\"]', {\n      y: -46, scale: .88, ease: 'none',\n      scrollTrigger: { trigger: '#top', start: 'top top', end: 'bottom top', scrub: .5 }\n    });\n\n    /* No entrance animation on readable headings: the page must be fully\n       legible without scrolling or motion. */\n\n    /* signature scene: watch stays, counterpart arrives */\n    var story = document.querySelector('[data-story]');\n    if (story) {\n      var tl = gsap.timeline({\n        defaults: { ease: 'none' },\n        scrollTrigger: { trigger: story, start: 'top top', end: 'bottom bottom', scrub: .6 }\n      });\n      tl.fromTo('[data-story-watch]', { xPercent: 0, scale: 1 }, { xPercent: -44, scale: .64, duration: .55 }, 0)\n        .to('[data-story-copy-a]', { opacity: 0, duration: .12 }, .16)\n        .fromTo('[data-story-app]', { opacity: 0, y: 44 }, { opacity: 1, y: 0, duration: .26 }, .18)\n        .fromTo('[data-story-line]', { scaleX: 0 }, { scaleX: 1, duration: .22 }, .44)\n        .to('[data-story-copy-b]', { opacity: 1, duration: .16 }, .58);\n    }\n  });\n})();\n</script>",
