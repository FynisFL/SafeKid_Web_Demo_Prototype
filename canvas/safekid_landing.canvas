ext-[#5A818D]\" data-kid=\"1-7-1-3-1-1-3\" data-name=\"edition Vietnamese label: Tý\">Tý</span></button></li>\n<li data-kid=\"1-7-1-3-2\" data-name=\"edition list item: Buffalo\"><button class=\"thumb block w-full rounded-[16px] bg-white p-3 text-left\" data-dynamic=\"true\" data-edition=\"buffalo\" data-kid=\"1-7-1-3-2-1\" data-label=\"Buffalo\" data-name=\"edition thumbnail button: Buffalo\" data-reason=\"aria-current toggled by script on selection\" data-vi=\"Sửu\" type=\"button\"><img alt=\"Buffalo edition\" class=\"mx-auto h-[92px] w-[92px] object-contain\" data-kid=\"1-7-1-3-2-1-1\" data-name=\"edition thumbnail image: Buffalo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/buffalo.png\"/><span class=\"mt-2 block text-center text-[13px] font-medium\" data-kid=\"1-7-1-3-2-1-2\" data-name=\"edition English label: Buffalo\">Buffalo</span><span class=\"block text-center text-[12px] text-[#5A818D]\" data-kid=\"1-7-1-3-2-1-3\" data-name=\"edition Vietnamese label: Sửu\">Sửu</span></button></li>\n<li data-kid=\"1-7-1-3-3\" data-name=\"edition list item: Tiger\"><button class=\"thumb block w-full rounded-[16px] bg-white p-3 text-left\" data-dynamic=\"true\" data-edition=\"tiger\" data-kid=\"1-7-1-3-3-1\" data-label=\"Tiger\" data-name=\"edition thumbnail button: Tiger\" data-reason=\"aria-current toggled by script on selection\" data-vi=\"Dần\" type=\"button\"><img alt=\"Tiger edition\" class=\"mx-auto h-[92px] w-[92px] object-contain\" data-kid=\"1-7-1-3-3-1-1\" data-name=\"edition thumbnail image: Tiger\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/tiger.png\"/><span class=\"mt-2 block text-center text-[13px] font-medium\" data-kid=\"1-7-1-3-3-1-2\" data-name=\"edition English label: Tiger\">Tiger</span><span class=\"block text-center text-[12px] text-[#5A818D]\" data-kid=\"1-7-1-3-3-1-3\" data-name=\"edition Vietnamese label: Dần\">Dần</span></button></li>\n<li data-kid=\"1-7-1-3-4\" data-name=\"