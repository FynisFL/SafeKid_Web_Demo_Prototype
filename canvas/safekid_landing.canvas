=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/rooster.png\"/><span class=\"mt-2 block text-center text-[13px] font-medium\" data-kid=\"1-7-1-3-10-1-2\" data-name=\"edition English label: Chick\">Chick</span><span class=\"block text-center text-[12px] text-[#5A818D]\" data-kid=\"1-7-1-3-10-1-3\" data-name=\"edition Vietnamese label: Dậu\">Dậu</span></button></li>\n<li data-kid=\"1-7-1-3-11\" data-name=\"edition list item: Puppy\"><button class=\"thumb block w-full rounded-[16px] bg-white p-3 text-left\" data-dynamic=\"true\" data-edition=\"dog\" data-kid=\"1-7-1-3-11-1\" data-label=\"Puppy\" data-name=\"edition thumbnail button: Puppy\" data-reason=\"aria-current toggled by script on selection\" data-vi=\"Tuất\" type=\"button\"><img alt=\"Puppy edition\" class=\"mx-auto h-[92px] w-[92px] object-contain\" data-kid=\"1-7-1-3-11-1-1\" data-name=\"edition thumbnail image: Puppy\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/dog.png\"/><span class=\"mt-2 block text-center text-[13px] font-medium\" data-kid=\"1-7-1-3-11-1-2\" data-name=\"edition English label: Puppy\">Puppy</span><span class=\"block text-center text-[12px] text-[#5A818D]\" data-kid=\"1-7-1-3-11-1-3\" data-name=\"edition Vietnamese label: Tuất\">Tuất</span></button></li>\n<li data-kid=\"1-7-1-3-12\" data-name=\"edition list item: Piggy\"><button class=\"thumb block w-full rounded-[16px] bg-white p-3 text-left\" data-dynamic=\"true\" data-edition=\"pig\" data-kid=\"1-7-1-3-12-1\" data-label=\"Piggy\" data-name=\"edition thumbnail button: Piggy\" data-reason=\"aria-current toggled by script on selection\" data-vi=\"Hợi\" type=\"button\"><img alt=\"Piggy edition\" class=\"mx-auto h-[92px] w-[92px] object-contain\" data-kid=\"1-7-1-3-12-1-1\" data-name=\"edition thumbnail image: Piggy\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/pig.png\"/><span class=\"mt-2 block text-center text-[13px] font-medium\" data-kid=\"1-7-1-3-12-1-2\" data-name=\"edition English label: Piggy\">Piggy</span><span class=\"block text-center text-[12px] text-[#5A818D]\" data-kid=\"1-7-1-3-12-1-3\" data-name=\"edition Vietnamese label: Hợi\">Hợi</span></button></li>\n<li class=\"flex items-end\" data-kid=\"1-7-1-3-13\" data-name=\"link row: All editions\"><a class=\"linkarrow inline-flex items-center gap-2 px-3 pb-3 text-[14px] font-medium\" data-kid=\"1-7-1-3-13-1\" data-name=\"all editions link\" href=\"#/zodiac\">All editions <i aria-hidden=\"true\" class=\"icon-arrow-right arrow text-[15px]\" data-kid=\"1-7-1-3-13-1-1\" data-name=\"right arrow icon\"></i></a></li>\n</ul>\n<p aria-live=\"polite\" class=\"sr-only\" data-dynamic=\"true\" data-kid=\"1-7-1-4\" data-live=\"\" data-name=\"screen-reader live region\" data-reason=\"text injected by script to announce selected edition\"></p>\n</div>\n</section>\n<!-- DEMO -->\n<section class=\"bg-[#0B2B33] py-[120px] text-white\" data-kid=\"1-8\" data-name=\"demo section\" id=\"demo\">\n<div class=\"mx-auto max-w-[1320px] px-8\" data-kid=\"1-8-1\" data-name=\"demo content wrapper\">\n<div class=\"grid grid-cols-12 items-end gap-8\" data-kid=\"1-8-1-1\" data-name=\"demo heading grid\">\n<h2 class=\"display col-span-6 text-[44px] leading-[1.1] text-[#F2FEFE]\" data-kid=\"1-8-1-1-1\" data-name=\"demo heading: Try pairing\">Try pairing the sample watch.</h2>\n<p class=\"col-span-4 col-start-9 text-[15px] leading-[1.6] text-[#B7F2F2]\" data-kid=\"1-8-1-1-2\" data-name=\"demo description\">Two controls, one local state. Nothing is scanned, connected or transmitted.</p>\n</div>\n<div class=\"mt-12 rounded-[26px] border border-white/15 p-8\" data-kid=\"1-8-1-2\" data-name=\"demo card with steps\">\n<div class=\"grid grid-cols-[1fr_auto_1fr] items-center gap-8\" data-kid=\"1-8-1-2-1\" data-name=\"demo three-step grid\">\n<div data-kid=\"1-8-1-2-1-1\" data-name=\"step 1 card: sample watch\">\n<p class=\"text-[13px] font-medium text-[#8FD3D8]\" data-kid=\"1-8-1-2-1-1-1\" data-name=\"step label: sample watch\">Step 1 — sample watch</p>\n<div class=\"mt-4 flex items-center gap-5\" data-kid=\"1-8-1-2-1-1-2\" data-name=\"watch preview row\">\n<img alt=\"Sample SafeKid watch\" class=\"h-24 w-24 object-contain\" data-kid=\"1-8-1-2-1-1-2-1\" data-name=\"sample watch thumbnail\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/rat.png\"/>\n<div data-kid=\"1-8-1-2-1-1-2-2\" data-name=\"watch preview text\">\n<p class=\"text-[16px] font-medium\" data-kid=\"1-8-1-2-1-1-2-2-1\" data-name=\"watch edition name\">Mouse edition</p>\n<p class=\"mt-1 max-w-[190px] text-[13px] leading-[1.5] text-[#9FDDE2]\" data-kid=\"1-8-1-2-1-1-2-2-2\" data-name=\"watch edition note\">A sample edition for this demonstration only.</p>\n</div>\n</div>\n<button class=\"mt-5 rounded-full bg-white px-5 py-2.5 text-[14px] font-medium text-[#0B2B33]\" data-dynamic=\"true\" data-kid=\"1-8-1-2-1-1-3\" data-name=\"select sample watch button\" data-reason=\"text and class toggled by script when selected\" data-select-watch=\"\" type=\"button\">Select sample watch</button>\n</div>\n<div class=\"flex flex-col items-center gap-2\" data-kid=\"1-8-1-2-1-2\" data-name=\"step connector column\">\n<span class=\"block h-px w-16 origin-left bg-[#00C7CA] opacity-30 transition-opacity duration-200\" data-demo-line=\"\" data-dynamic=\"true\" data-kid=\"1-8-1-2-1-2-1\" data-name=\"connector line to phone\" data-reason=\"opacity driven by script based on pairing state\"></span>\n<p class=\"text-[12px] text-[#8FD3D8]\" data-kid=\"1-8-1-2-1-2-2\" data-name=\"local label\">local</p>\n</div>\n<div data-kid=\"1-8-1-2-1-3\" data-name=\"step 2 card: parent-app demo\">\n<p class=\"text-[13px] font-medium text-[#8FD3D8]\" data-kid=\"1-8-1-2-1-3-1\" data-name=\"step label: parent-app demo\">Step 2 — parent-app demo</p>\n<div class=\"mt-4 rounded-[14px] bg-white/8 px-5 py-4\" data-kid=\"1-8-1-2-1-3-2\" data-name=\"phone confirm panel\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-8-1-2-1-3-2-1\" data-name=\"phone action row\">\n<i aria-hidden=\"true\" class=\"icon-phone text-[16px] text-[#B7F2F2]\" data-kid=\"1-8-1-2-1-3-2-1-1\" data-name=\"phone icon\"></i>\n<p class=\"text-[15px]\" data-kid=\"1-8-1-2-1-3-2-1-2\" data-name=\"phone action label\">Confirm from the phone</p>\n</div>\n<p class=\"mt-1.5 text-[13px] leading-[1.5] text-[#9FDDE2]\" data-kid=\"1-8-1-2-1-3-2-2\" data-name=\"phone action note\">The only effect is a line of text on this page.</p>\n</div>\n<div class=\"mt-4 flex items-center gap-3\" data-kid=\"1-8-1-2-1-3-3\" data-name=\"demo action buttons row\">\n<button class=\"rounded-full bg-[#00C7CA] px-5 py-2.5 text-[14px] font-medium text-[#04262E] disabled:cursor-not-allowed disabled:opacity-35\" data-confirm-pairing=\"\" data-dynamic=\"true\" data-kid=\"1-8-1-2-1-3-3-1\" data-name=\"confirm pairing button\" data-reason=\"disabled state driven by script after watch selection\" disabled=\"\" type=\"button\">Confirm demo pairing</button>\n<button class=\"inline-flex items-center gap-2 px-2 py-2 text-[13px] text-[#9FDDE2] hover:text-white\" data-kid=\"1-8-1-2-1-3-3-2\" data-name=\"reset demo button\" data-reset-pairing=\"\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-rotate-ccw text-[14px]\" data-kid=\"1-8-1-2-1-3-3-2-1\" data-name=\"reset icon\"></i> Reset demo</button>\n</div>\n</div>\n</div>\n<p aria-live=\"polite\" class=\"mt-8 text-[14px] text-[#8FD3D8]\" data-dynamic=\"true\" data-kid=\"1-8-1-2-2\" data-name=\"pairing status line\" data-pairing-result=\"\" data-reason=\"text replaced by script to reflect pairing state\" role=\"status\">Nothing selected yet.</p>\n</div>\n<div class=\"mt-10 flex items-center justify-between border-t border-white/15 pt-6\" data-kid=\"1-8-1-3\" data-name=\"prototypes footer row\">\n<p class=\"text-[14px] text-[#9FDDE2]\" data-kid=\"1-8-1-3-1\" data-name=\"prototypes label\">Supporting prototypes, all local:</p>\n<div class=\"flex items-center gap-8 text-[14px]\" data-kid=\"1-8-1-3-2\" data-name=\"prototype links row\">\n<a class=\"linkarrow inline-flex items-center gap-2 text-white\" data-kid=\"1-8-1-3-2-1\" data-name=\"prototype link: SOS simulation\" href=\"#/sos\">SOS simulation <i aria-hidden=\"true\" class=\"icon-arrow-right arrow text-[15px]\" data-kid=\"1-8-1-3-2-1-1\" data-name=\"right arrow icon\"></i></a>\n<a class=\"linkarrow inline-flex items-center gap-2 text-white\" data-kid=\"1-8-1-3-2-2\" data-name=\"prototype link: AI chat\" href=\"#/chat\">S.F AI chat <i aria-hidden=\"true\" class=\"icon-arrow-right arrow text-[15px]\" data-kid=\"1-8-1-3-2-2-1\" data-name=\"right arrow icon\"></i></a>\n<a class=\"linkarrow inline-flex items-center gap-2 text-white\" data-current-link=\"\" data-dynamic=\"true\" data-kid=\"1-8-1-3-2-3\" data-name=\"prototype link: edition details\" data-reason=\"href and label rewritten by script for current edition\" href=\"#/product/rat\"><span data-current-label=\"\" data-dynamic=\"true\" data-kid=\"1-8-1-3-2-3-1\" data-name=\"edition name in link\" data-reason=\"text replaced by script for current edition\">Mouse</span> details <i aria-hidden=\"true\" class=\"icon-arrow-right arrow text-[15px]\" data-kid=\"1-8-1-3-2-3-2\" data-name=\"right arrow icon\"></i></a>\n</div>\n</div>\n<p class=\"mt-4 text-[13px] text-[#8FD3D8]\" data-kid=\"1-8-1-4\" data-name=\"demo disclaimer\">SOS acknowledges a press and sends nothing. S.F AI is not emergency support. Edition pages come from the design template.</p>\n</div>\n</section>\n<!-- CLOSING -->\n<section class=\"bg-white pb-24 pt-[110px]\" data-kid=\"1-9\" data-name=\"closing section\">\n<div class=\"mx-auto max-w-[1320px] px-8\" data-kid=\"1-9-1\" data-name=\"closing content wrapper\">\n<p class=\"text-[13px] text-[#5A818D]\" data-kid=\"1-9-1-1\" data-name=\"developer credit line\">Developed by <span class=\"font-medium text-[#255E72]\" data-kid=\"1-9-1-1-1\" data-name=\"developer name: DigiBabi\">DigiBabi</span></p>\n<div class=\"mt-12 flex items-end justify-between gap-12\" data-kid=\"1-9-1-2\" data-name=\"closing CTA grid\">\n<h2 class=\"display max-w-[620px] text-[46px] leading-[1.1]\" data-kid=\"1-9-1-2-1\" data-name=\"closing headline\">Explore the edition they choose.</h2>\n<div class=\"flex items-center gap-6\" data-kid=\"1-9-1-2-2\" data-name=\"closing edition display\">\n<img alt=\"Selected edition\" class=\"h-[110px] w-[110px] object-contain\" data-closing-img=\"\" data-dynamic=\"true\" data-kid=\"1-9-1-2-2-1\" data-name=\"selected edition image\" data-reason=\"src changed by script to match selected edition\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/rat.png\"/>\n<div data-kid=\"1-9-1-2-2-2\" data-name=\"selected edition text\">\n<p class=\"text-[17px] font-medium\" data-dynamic=\"true\" data-kid=\"1-9-1-2-2-2-1\" data-name=\"edition name heading\" data-reason=\"English name text replaced by script per selected edition\"><span data-current-label=\"\" data-dynamic=\"true\" data-kid=\"1-9-1-2-2-2-1-1\" data-name=\"edition name: Mouse\" data-reason=\"text replaced by script for current selection\">Mouse</span> edition</p>\n<p class=\"text-[13px] text-[#4A7481]\" data-kid=\"1-9-1-2-2-2-2\" data-name=\"edition Vietnamese caption\">Vietnamese Zodiac: <span data-current-vi=\"\" data-dynamic=\"true\" data-kid=\"1-9-1-2-2-2-2-1\" data-name=\"edition Vietnamese name: Tý\" data-reason=\"text replaced by script for current selection\">Tý</span></p>\n<a class=\"pill mt-3 bg-[#0B2B33] text-[14px] text-white hover:bg-[#124049]\" data-current-link=\"\" data-dynamic=\"true\" data-kid=\"1-9-1-2-2-2-3\" data-name=\"view edition button\" data-reason=\"href and aria-label rewritten by script for current edition\" href=\"#/product/rat\"><span data-current-action=\"\" data-dynamic=\"true\" data-kid=\"1-9-1-2-2-2-3-1\" data-name=\"view edition button label\" data-reason=\"text replaced by script for current edition\">View Mouse edition</span></a>\n</div>\n</div>\n</div>\n<a class=\"linkarrow mt-10 inline-flex items-center gap-2 text-[14px] font-medium\" data-kid=\"1-9-1-3\" data-name=\"contact text link\" href=\"#/contact\">Ask about SafeKid <i aria-hidden=\"true\" class=\"icon-arrow-right arrow text-[15px]\" data-kid=\"1-9-1-3-1\" data-name=\"right arrow icon\"></i></a>\n</div>\n</section>\n<!-- FOOTER -->\n<footer class=\"bg-[#0B2B33] py-14 text-[#EAFBFB]\" data-kid=\"1-10\" data-name=\"site footer\">\n<div class=\"mx-auto max-w-[1320px] px-8\" data-kid=\"1-10-1\" data-name=\"footer inner bar\">\n<div class=\"flex items-start justify-between gap-12\" data-kid=\"1-10-1-1\" data-name=\"footer top row\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-10-1-1-1\" data-name=\"footer brand block\">\n<img alt=\"\" class=\"h-8 w-8 object-contain\" data-kid=\"1-10-1-1-1-1\" data-name=\"footer brand logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/brand/Logo_SafeKid.png\"/>\n<div data-kid=\"1-10-1-1-1-2\" data-name=\"footer brand text group\">\n<p class=\"display text-[16px] font-bold\" data-kid=\"1-10-1-1-1-2-1\" data-name=\"footer brand name\">SafeKid</p>\n<p class=\"text-[13px] text-[#8FD3D8]\" data-kid=\"1-10-1-1-1-2-2\" data-name=\"footer brand tagline\">Inspired by the Vietnamese Zodiac.</p>\n</div>\n</div>\n<nav aria-label=\"Footer\" class=\"grid grid-cols-3 gap-x-16 gap-y-2 text-[14px] text-[#B7F2F2]\" data-kid=\"1-10-1-1-2\" data-name=\"footer navigation links\">\n<a class=\"hover:text-white\" data-kid=\"1-10-1-1-2-1\" data-name=\"footer link: Home\" href=\"#top\">Home</a>\n<a class=\"hover:text-white\" data-kid=\"1-10-1-1-2-2\" data-name=\"footer link: Zodiac Collection\" href=\"#/zodiac\">Zodiac Collection</a>\n<a class=\"hover:text-white\" data-kid=\"1-10-1-1-2-3\" data-name=\"footer link: Support\" href=\"#/support\">Support</a>\n<a class=\"hover:text-white\" data-kid=\"1-10-1-1-2-4\" data-name=\"footer link: Capabilities\" href=\"#capabilities\">Capabilities</a>\n<a class=\"hover:text-white\" data-kid=\"1-10-1-1-2-5\" data-name=\"footer link: About\" href=\"#/about\">About</a>\n<a class=\"hover:text-white\" data-kid=\"1-10-1-1-2-6\" data-name=\"footer link: Contact\" href=\"#/contact\">Contact</a>\n<a class=\"hover:text-white\" data-kid=\"1-10-1-1-2-7\" data-name=\"footer link: SOS simulation\" href=\"#/sos\">SOS simulation</a>\n<a class=\"hover:text-white\" data-kid=\"1-10-1-1-2-8\" data-name=\"footer link: AI prototype\" href=\"#/chat\">S.F AI prototype</a>\n<a class=\"hover:text-white\" data-kid=\"1-10-1-1-2-9\" data-name=\"footer link: support email\" href=\"mailto:support@safekid.com\">support@safekid.com</a>\n</nav>\n</div>\n<div class=\"mt-10 flex items-center justify-between border-t border-white/15 pt-5 text-[13px] text-[#8FD3D8]\" data-kid=\"1-10-1-2\" data-name=\"footer bottom row\">\n<p data-kid=\"1-10-1-2-1\" data-name=\"footer copyright notice\">© 2026 SafeKid. Concept site for demonstration.</p>\n<p data-kid=\"1-10-1-2-2\" data-name=\"footer developer credit\">Developed by DigiBabi</p>\n</div>\n</div>\n</footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\"></script>\n<script>\n(function(){\n  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n  /* ---------- edition selector ---------- */\n  var buttons = Array.prototype.slice.call(document.querySelectorAll('[data-edition]'));\n  var stack = Array.prototype.slice.call(document.querySelectorAll('[data-edition-img]'));\n  var closingImg = document.querySelector('[data-closing-img]');\n  var live = document.querySelector('[data-live]');\n  var committed = 'rat', preview = null;\n\n  function paint(id, announce){\n    stack.forEach(function(img){ img.classList.toggle('is-active', img.getAttribute('data-edition-img') === id); });\n    var btn = buttons.filter(function(b){ return b.getAttribute('data-edition') === id; })[0];\n    if (!btn) return;\n    var label = btn.getAttribute('data-label'), vi = btn.getAttribute('data-vi');\n    document.querySelectorAll('[data-current-label]').forEach(function(el){ el.textContent = label; });\n    document.querySelectorAll('[data-current-vi]').forEach(function(el){ el.textContent = vi; });\n    document.querySelectorAll('[data-current-action]').forEach(function(el){ el.textContent = 'View ' + label + ' edition'; });\n    document.querySelectorAll('[data-current-link]').forEach(function(el){\n      el.setAttribute('href', '#/product/' + id);\n      el.setAttribute('aria-label', 'View ' + label + ' edition details');\n    });\n    if (closingImg) closingImg.src = '/api/local/images/src/assets/products/' + id + '.png';\n    buttons.forEach(function(b){ b.setAttribute('aria-current', b.getAttribute('data-edition') === id ? 'true' : 'false'); });\n    if (announce && live) live.textContent = label + ' edition selected.';\n  }\n  buttons.forEach(function(btn){\n    var id = btn.getAttribute('data-edition');\n    btn.addEventListener('mouseenter', function(){ preview = id; paint(id, false); });\n    btn.addEventListener('focus', function(){ preview = id; paint(id, false); });\n    btn.addEventListener('click', function(){ committed = id; preview = null; paint(id, true); });\n  });\n  var sheet = document.querySelector('[aria-label=\"All twelve editions\"]');\n  if (sheet) sheet.addEventListener('mouseleave', function(){ if (preview !== null) { preview = null; paint(committed, false); } });\n  paint(committed, false);\n\n  /* ---------- reciprocal inspection ---------- */\n  var COPY = [\n    'Two participants, one product. The watch carries the actions; the app is where a parent sees them.',\n    'Calling runs both ways. The parent calls the watch, and the watch can call back.',\n    'A safe zone is a named area. In the concept it can raise a notice for the parent, and nothing else.'\n  ];\n  var viewBtns = Array.prototype.slice.call(document.querySelectorAll('[data-view]'));\n  var panels = Array.prototype.slice.call(document.querySelectorAll('[data-state]'));\n  var line = document.querySelector('[data-scene-line]');\n  var current = 0;\n\n  function setState(i, fromScroll){\n    current = i;\n    viewBtns.forEach(function(b){ b.setAttribute('aria-pressed', String(Number(b.getAttribute('data-view')) === i)); });\n    panels.forEach(function(p){ p.classList.toggle('is-on', Number(p.getAttribute('data-state')) === i); });\n    if (line) line.textContent = COPY[i];\n    if (!fromScroll) {\n      var scene = document.querySelector('[data-scene]');\n      if (scene) {\n        var top = scene.getBoundingClientRect().top + window.scrollY;\n        var span = scene.offsetHeight - window.innerHeight;\n        var target = top + span * [0.12, 0.5, 0.88][i];\n        window.scrollTo({ top: target, behavior: reduce ? 'auto' : 'smooth' });\n      }\n    }\n  }\n  viewBtns.forEach(function(btn){\n    btn.addEventListener('click', function(){ setState(Number(btn.getAttribute('data-view')), false); });\n  });\n  setState(0, true);\n\n  /* ---------- pairing demo ---------- */\n  var selected = false, paired = false;\n  var selBtn = document.querySelector('[data-select-watch]');\n  var confBtn = document.querySelector('[data-confirm-pairing]');\n  var resetBtn = document.querySelector('[data-reset-pairing]');\n  var result = document.querySelector('[data-pairing-result]');\n  var demoLine = document.querySelector('[data-demo-line]');\n\n  function pairingUI(){\n    if (!selBtn || !confBtn || !result) return;\n    selBtn.textContent = selected ? 'Sample watch selected' : 'Select sample watch';\n    selBtn.classList.toggle('bg-white', !selected);\n    selBtn.classList.toggle('bg-[#00C7CA]', selected);\n    confBtn.disabled = !selected;\n    if (demoLine) { demoLine.style.opacity = (selected || paired) ? '1' : '0.3'; }\n    if (paired) result.textContent = 'Pairing demonstration complete. No real watch is connected.';\n    else if (selected) result.textContent = 'Step 1 done. Confirm from the parent-app demo to finish.';\n    else result.textContent = 'Nothing selected yet.';\n  }\n  if (selBtn) selBtn.addEventListener('click', function(){ if (!paired) { selected = true; pairingUI(); } });\n  if (confBtn) confBtn.addEventListener('click', function(){ if (selected) { paired = true; pairingUI(); } });\n  if (resetBtn) resetBtn.addEventListener('click', function(){ selected = false; paired = false; pairingUI(); });\n  pairingUI();\n\n  /* ---------- motion ---------- */\n  if (!window.gsap) return;\n  if (window.ScrollTrigger) gsap.registerPlugin(ScrollTrigger);\n\n  if (!reduce) {\n    var intro = gsap.timeline({ defaults: { ease: 'power3.out' } });\n    intro.from('[data-hero=\"product\"]', { y: 40, scale: .95, duration: 1.0 })\n         .from('[data-hero=\"title\"]', { y: 22, duration: .9 }, '-=.6')\n         .from('[data-hero=\"aside\"]', { y: 16, duration: .8 }, '-=.7')\n         .from('[data-hero=\"actions\"]', { y: 12, duration: .7 }, '-=.6');\n\n    gsap.to('[data-hero=\"product\"]', {\n      y: -40, scale: .9, ease: 'none',\n      scrollTrigger: { trigger: '#top', start: 'top top', end: 'bottom top', scrub: .5 }\n    });\n\n    /* scroll advances the inspection views without hijacking the scrollbar */\n    var scene = document.querySelector('[data-scene]');\n    if (scene) {\n      ScrollTrigger.create({\n        trigger: scene, start: 'top top', end: 'bottom bottom',\n        onUpdate: function(self){\n          var i = self.progress < 0.34 ? 0 : (self.progress < 0.67 ? 1 : 2);\n          if (i !== current) setState(i, true);\n        }\n      });\n    }\n  }\n})();\n</script>",
