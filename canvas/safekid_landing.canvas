  "nodes": {
    "var_851e4c1ff90c": {
      "type": "variant",
      "label": "Cinematic 1 · The space between (1440)",
      "parentId": "var_6cd275204a1e",
      "themeId": null,
      "rect": {
        "x": 5110,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n  :root{\n    --ink:#0B2B33; --ink-soft:#1C4A57; --teal:#255E72; --cyan:#00C7CA;\n    --mint:#83E3E3; --sky:#B7F2F2; --mist:#F4FBFB; --line:#D7EDEF;\n    --display:'Plus Jakarta Sans',system-ui,sans-serif;\n    --text:'Inter',system-ui,sans-serif;\n  }\n  @layer base{\n    body{background:#fff;color:var(--ink);font-family:var(--text);font-size:17px;line-height:1.65;-webkit-font-smoothing:antialiased}\n    a:focus-visible,button:focus-visible{outline:2px solid var(--ink);outline-offset:4px;border-radius:6px}\n    ::selection{background:#B7F2F2;color:#0B2B33}\n  }\n  @layer components{\n    .display{font-family:var(--display);letter-spacing:-.025em;font-weight:600}\n    .pill{display:inline-flex;align-items:center;gap:.6rem;border-radius:999px;padding:.95rem 1.6rem;font-size:15px;font-weight:500;white-space:nowrap;transition:background-color .2s ease,color .2s ease}\n    .arrow{transition:transform .2s ease}\n    .linkarrow:hover .arrow{transform:translateX(4px)}\n    .edimg{position:absolute;inset:0;height:100%;width:100%;object-fit:contain;opacity:0;transition:opacity .18s ease}\n    .edimg.is-active{opacity:1}\n    .edname{transition:color .18s ease}\n    .edname[aria-current=\"true\"]{color:var(--ink)}\n    .edname[aria-current=\"true\"] .dot{opacity:1;transform:scale(1)}\n    .dot{opacity:0;transform:scale(.4);transition:opacity .18s ease,transform .18s ease}\n    @media (prefers-reduced-motion: reduce){\n      .edimg,.dot,.arrow,.edname{transition:none}\n      [data-story]{height:auto !important}\n      [data-story-stage]{position:relative !important;height:auto !important;padding:5rem 0}\n    }\n  }\n</style>\n<div class=\"w-full overflow-x-clip bg-white\" data-kid=\"1\">\n<!-- NAV -->\n<header class=\"relative z-30\" data-kid=\"1-1\">\n<div class=\"mx-auto flex max-w-[1320px] items-center justify-between px-8 py-6\" data-kid=\"1-1-1\">\n<a aria-label=\"SafeKid home\" class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" href=\"#top\">\n<img alt=\"\" class=\"h-9 w-9 object-contain\" data-kid=\"1-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/brand/Logo_SafeKid.png\"/>\n<span class=\"display text-[19px] font-bold tracking-[-.02em]\" data-kid=\"1-1-1-1-2\">SafeKid</span>\n</a>\n<nav aria-label=\"Main\" class=\"flex items-center gap-9 text-[14px] text-[#255E72]\" data-kid=\"1-1-1-2\">\n<a class=\"hover:text-[#0B2B33]\" data-kid=\"1-1-1-2-1\" href=\"#collection\">Collection</a>\n<a class=\"hover:text-[#0B2B33]\" data-kid=\"1-1-1-2-2\" href=\"#how\">How it works</a>\n<a class=\"hover:text-[#0B2B33]\" data-kid=\"1-1-1-2-3\" href=\"#prototypes\">Try prototypes</a>\n<a class=\"hover:text-[#0B2B33]\" data-kid=\"1-1-1-2-4\" href=\"#/support\">Support</a>\n</nav>\n<a class=\"text-[14px] font-medium text-[#0B2B33] underline decoration-[#B7F2F2] decoration-2 underline-offset-[6px]\" data-kid=\"1-1-1-3\" href=\"#/contact\">Contact</a>\n</div>\n</header>\n<!-- HERO -->\n<section class=\"relative overflow-x-clip bg-[linear-gradient(180deg,#FFFFFF_0%,#F8FEFE_46%,#E9FAFA_100%)]\" data-kid=\"1-2\" id=\"top\">\n<div class=\"mx-auto max-w-[1320px] px-8\" data-kid=\"1-2-1\">\n<div class=\"relative h-[720px]\" data-kid=\"1-2-1-1\">\n<h1 class=\"display absolute left-0 top-2 max-w-[660px] text-[66px] leading-[1.02]\" data-hero=\"title\" data-kid=\"1-2-1-1-1\">\n          A little more<br data-kid=\"1-2-1-1-1-1\"/>independence.\n        </h1>\n<div class=\"absolute inset-x-0 bottom-0 flex justify-center\" data-kid=\"1-2-1-1-2\">\n<div class=\"relative flex h-[560px] w-[560px] items-end justify-center\" data-kid=\"1-2-1-1-2-1\">\n<span aria-hidden=\"true\" class=\"absolute bottom-6 h-[54px] w-[330px] rounded-[50%] bg-[#9FE3E6]/45 blur-[38px]\" data-kid=\"1-2-1-1-2-1-1\"></span>\n<img alt=\"The SafeKid smartwatch, Mouse edition, from the Vietnamese Zodiac collection\" class=\"relative mb-2 w-[500px] max-w-none drop-shadow-[0_28px_40px_rgba(21,90,102,0.18)]\" data-hero=\"product\" data-kid=\"1-2-1-1-2-1-2\" decoding=\"async\" src=\"/api/local/images/src/assets/figma/zodiac-collection-hero-watch.png\"/>\n</div>\n</div>\n<div class=\"absolute bottom-10 right-0 max-w-[352px]\" data-hero=\"aside\" data-kid=\"1-2-1-1-3\">\n<p class=\"text-[17px] leading-[1.6] text-[#255E72]\" data-kid=\"1-2-1-1-3-1\">\n            SafeKid is a smartwatch concept for children aged 4–10, designed around a connected parent-app experience.\n          </p>\n<div class=\"mt-6 flex items-center gap-5\" data-kid=\"1-2-1-1-3-2\">\n<a class=\"pill whitespace-nowrap bg-[#0B2B33] text-white hover:bg-[#124049]\" data-kid=\"1-2-1-1-3-2-1\" href=\"#how\">See how it connects</a>\n<a class=\"linkarrow inline-flex items-center gap-2 whitespace-nowrap text-[15px] font-medium\" data-kid=\"1-2-1-1-3-2-2\" href=\"#collection\">12 editions <i aria-hidden=\"true\" class=\"icon-arrow-right arrow text-[16px]\" data-kid=\"1-2-1-1-3-2-2-1\"></i></a>\n</div>\n<p class=\"mt-5 text-[13px] text-[#4A7481]\" data-kid=\"1-2-1-1-3-3\">Concept site. No watch is connected.</p>\n</div>\n</div>\n</div>\n</section>\n<!-- EMOTIONAL INTERLUDE -->\n<section class=\"relative overflow-x-clip bg-[#0B2B33] py-[150px] text-[#EAFBFB]\" data-kid=\"1-3\">\n<div class=\"mx-auto max-w-[1320px] px-8\" data-kid=\"1-3-1\">\n<div class=\"grid grid-cols-12 items-start gap-8\" data-kid=\"1-3-1-1\">\n<h2 class=\"display col-span-7 text-[54px] leading-[1.08] text-[#F2FEFE]\" data-kid=\"1-3-1-1-1\">\n          More room to explore.<br data-kid=\"1-3-1-1-1-1\"/>\n          A way to stay connected.\n        </h2>\n<div class=\"col-span-4 col-start-9 pt-3\" data-kid=\"1-3-1-1-2\">\n<p class=\"text-[17px] leading-[1.7] text-[#B7F2F2]\" data-kid=\"1-3-1-1-2-1\">\n            SafeKid is designed for the years when a child starts walking to a friend's house on their own, and a parent starts wondering whether to call. The watch is how they reach you. The app is how you check in.\n          </p>\n<p class=\"mt-5 text-[13px] text-[#8FD3D8]\" data-kid=\"1-3-1-1-2-2\">Both sides are described here as a product concept.</p>\n</div>\n</div>\n</div>\n</section>\n<!-- SIGNATURE SCENE -->\n<section class=\"relative bg-[#F4FBFB]\" data-kid=\"1-4\" data-name=\"signature story section with scroll-driven animated scene\" data-story=\"\" id=\"how\" style=\"height:180vh\">\n<div class=\"sticky top-0 flex h-screen items-center overflow-hidden\" data-kid=\"1-4-1\" data-story-stage=\"\">\n<div class=\"mx-auto w-full max-w-[1320px] px-8\" data-kid=\"1-4-1-1\">\n<div class=\"flex items-center justify-between\" data-kid=\"1-4-1-1-1\">\n<p class=\"text-[14px] font-medium text-[#255E72]\" data-kid=\"1-4-1-1-1-1\">One watch, two perspectives</p>\n<p class=\"flex items-center gap-2 text-[13px] text-[#4A7481]\" data-kid=\"1-4-1-1-1-2\">\n<span class=\"inline-block h-1.5 w-1.5 rounded-full bg-[#00C7CA]\" data-kid=\"1-4-1-1-1-2-1\"></span>\n            Designed interaction. Not connected to a real watch.\n          </p>\n</div>\n<div class=\"relative mt-8 h-[560px]\" data-kid=\"1-4-1-1-2\" data-name=\"scene stage sticky viewport\">\n<!-- watch -->\n<div class=\"absolute left-1/2 top-1/2 h-[520px] w-[520px] -translate-x-1/2 -translate-y-1/2\" data-kid=\"1-4-1-1-2-1\" data-name=\"central watch image container\">\n<img alt=\"SafeKid watch\" class=\"h-full w-full object-contain drop-shadow-[0_26px_36px_rgba(21,90,102,0.16)]\" data-dynamic=\"true\" data-kid=\"1-4-1-1-2-1-1\" data-name=\"story watch product image\" data-reason=\"transform (xPercent/scale) scrubbed by ScrollTrigger story timeline\" data-story-watch=\"\" decoding=\"async\" src=\"/api/local/images/src/assets/figma/zodiac-collection-hero-watch.png\"/>\n</div>\n<!-- connector -->\n<div class=\"absolute left-[41%] right-[28%] top-1/2 h-px origin-left bg-[#9BDDE0]\" data-dynamic=\"true\" data-kid=\"1-4-1-1-2-2\" data-name=\"connector line between watch and parent app\" data-reason=\"scaleX scrubbed from 0 to 1 by scroll story timeline\" data-story-line=\"\"></div>\n<!-- parent app concept -->\n<div class=\"absolute right-0 top-1/2 w-[380px] -translate-y-1/2\" data-dynamic=\"true\" data-kid=\"1-4-1-1-2-3\" data-name=\"parent app concept panel\" data-reason=\"opacity and y scrubbed by scroll story timeline; reduced-motion forces opacity 1\" data-story-app=\"\">\n<div class=\"rounded-[22px] bg-white p-7 shadow-[0_18px_40px_rgba(21,90,102,0.10)]\" data-kid=\"1-4-1-1-2-3-1\">\n<p class=\"text-[13px] font-medium text-[#255E72]\" data-kid=\"1-4-1-1-2-3-1-1\">Parent app concept</p>\n<div class=\"mt-5 flex items-center gap-3 rounded-[14px] bg-[#F0FBFB] px-4 py-3.5\" data-kid=\"1-4-1-1-2-3-1-2\">\n<i aria-hidden=\"true\" class=\"icon-map-pin text-[18px] text-[#255E72]\" data-kid=\"1-4-1-1-2-3-1-2-1\"></i>\n<div data-kid=\"1-4-1-1-2-3-1-2-2\">\n<p class=\"text-[15px] font-medium\" data-kid=\"1-4-1-1-2-3-1-2-2-1\">Location view</p>\n<p class=\"text-[13px] leading-[1.45] text-[#4A7481]\" data-kid=\"1-4-1-1-2-3-1-2-2-2\">Where the watch would report to be.</p>\n</div>\n</div>\n<div class=\"mt-2.5 flex items-center gap-3 rounded-[14px] bg-[#F0FBFB] px-4 py-3.5\" data-kid=\"1-4-1-1-2-3-1-3\">\n<i aria-hidden=\"true\" class=\"icon-phone text-[18px] text-[#255E72]\" data-kid=\"1-4-1-1-2-3-1-3-1\"></i>\n<div data-kid=\"1-4-1-1-2-3-1-3-2\">\n<p class=\"text-[15px] font-medium\" data-kid=\"1-4-1-1-2-3-1-3-2-1\">Call from the phone</p>\n<p class=\"text-[13px] leading-[1.45] text-[#4A7481]\" data-kid=\"1-4-1-1-2-3-1-3-2-2\">The other half of two-way calling.</p>\n</div>\n</div>\n<p class=\"mt-5 text-[12px] text-[#5A818D]\" data-kid=\"1-4-1-1-2-3-1-4\">Concept screen, drawn only to show where information would appear.</p>\n</div>\n</div>\n<!-- captions -->\n<div class=\"absolute bottom-2 left-1/2 -translate-x-1/2 text-center\" data-dynamic=\"true\" data-kid=\"1-4-1-1-2-4\" data-name=\"story caption for child's watch\" data-reason=\"opacity scrubbed/faded out by scroll story timeline; reduced-motion forces opacity 0\" data-story-copy-a=\"\">\n<p class=\"text-[15px] font-medium\" data-kid=\"1-4-1-1-2-4-1\">Child's watch</p>\n<p class=\"mt-1 text-[14px] text-[#4A7481]\" data-kid=\"1-4-1-1-2-4-2\">The screen shows the time and the edition character.</p>\n</div>\n<div class=\"absolute bottom-0 left-0 max-w-[320px] opacity-0\" data-dynamic=\"true\" data-kid=\"1-4-1-1-2-5\" data-name=\"story caption for two-way call\" data-reason=\"opacity scrubbed/faded in by scroll story timeline; reduced-motion forces opacity 1\" data-story-copy-b=\"\">\n<p class=\"text-[15px] font-medium\" data-kid=\"1-4-1-1-2-5-1\">A call, from both sides</p>\n<p class=\"mt-1 text-[14px] leading-[1.6] text-[#4A7481]\" data-kid=\"1-4-1-1-2-5-2\">On the watch, a call is one button. On the phone, it is the same call seen from the parent's end. The line between them is the designed relationship, not live data.</p>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- CAPABILITIES -->\n<section class=\"bg-white py-[130px]\" data-kid=\"1-5\" id=\"features\">\n<div class=\"mx-auto max-w-[1320px] px-8\" data-kid=\"1-5-1\">\n<div class=\"grid grid-cols-12 items-end gap-8\" data-kid=\"1-5-1-1\">\n<h2 class=\"display col-span-6 text-[46px] leading-[1.1]\" data-kid=\"1-5-1-1-1\">Six designed capabilities.</h2>\n<p class=\"col-span-5 col-start-8 text-[15px] leading-[1.6] text-[#4A7481]\" data-kid=\"1-5-1-1-2\">\n          What the concept includes, named as they appear in the project. Only the SOS simulation and the chat screen run on this site.\n        </p>\n</div>\n<!-- knowing where -->\n<div class=\"mt-16 grid grid-cols-12 gap-8 border-t border-[#D7EDEF] pt-8\" data-kid=\"1-5-1-2\">\n<h3 class=\"col-span-3 text-[15px] font-medium text-[#255E72]\" data-kid=\"1-5-1-2-1\">Knowing where they are</h3>\n<div class=\"col-span-9 grid grid-cols-2 gap-12\" data-kid=\"1-5-1-2-2\">\n<div data-kid=\"1-5-1-2-2-1\">\n<p class=\"text-[22px] font-semibold tracking-[-.01em]\" data-kid=\"1-5-1-2-2-1-1\">Real-Time GPS Tracking</p>\n<p class=\"mt-2 max-w-[380px] text-[16px] leading-[1.65] text-[#255E72]\" data-kid=\"1-5-1-2-2-1-2\">Location information taken from the watch and shown in the parent-app view.</p>\n</div>\n<div data-kid=\"1-5-1-2-2-2\">\n<p class=\"text-[22px] font-semibold tracking-[-.01em]\" data-kid=\"1-5-1-2-2-2-1\">Safe Zone Alerts</p>\n<p class=\"mt-2 max-w-[380px] text-[16px] leading-[1.65] text-[#255E72]\" data-kid=\"1-5-1-2-2-2-2\">A named area around home or school that can raise a notice in the concept.</p>\n</div>\n</div>\n</div>\n<!-- reaching each other -->\n<div class=\"mt-20 grid grid-cols-12 gap-8 border-t border-[#D7EDEF] pt-8\" data-kid=\"1-5-1-3\">\n<h3 class=\"col-span-3 text-[15px] font-medium text-[#255E72]\" data-kid=\"1-5-1-3-1\">Reaching each other</h3>\n<div class=\"col-span-4\" data-kid=\"1-5-1-3-2\">\n<p class=\"text-[22px] font-semibold tracking-[-.01em]\" data-kid=\"1-5-1-3-2-1\">Two-Way Calling</p>\n<p class=\"mt-2 max-w-[330px] text-[16px] leading-[1.65] text-[#255E72]\" data-kid=\"1-5-1-3-2-2\">A call in both directions, between the watch and the parent's phone.</p>\n</div>\n<div class=\"col-span-1 flex justify-center\" data-kid=\"1-5-1-3-3\">\n<span class=\"h-full w-px bg-[#D7EDEF]\" data-kid=\"1-5-1-3-3-1\"></span>\n</div>\n<div class=\"col-span-4\" data-kid=\"1-5-1-3-4\">\n<p class=\"text-[22px] font-semibold tracking-[-.01em]\" data-kid=\"1-5-1-3-4-1\">One-Touch SOS Button</p>\n<p class=\"mt-2 max-w-[340px] text-[16px] leading-[1.65] text-[#255E72]\" data-kid=\"1-5-1-3-4-2\">One press on the watch is the intended alert path.</p>\n<p class=\"mt-3 rounded-[10px] bg-[#F0FBFB] px-3 py-2 text-[13px] leading-[1.5] text-[#255E72]\" data-kid=\"1-5-1-3-4-3\">\n            The website offers a local simulation only. No emergency alert is sent.\n          </p>\n<a class=\"linkarrow mt-4 inline-flex items-center gap-2 text-[14px] font-medium\" data-kid=\"1-5-1-3-4-4\" href=\"#prototypes\">Open the SOS simulation <i aria-hidden=\"true\" class=\"icon-arrow-right arrow text-[15px]\" data-kid=\"1-5-1-3-4-4-1\"></i></a>\n</div>\n</div>\n<!-- everyday -->\n<div class=\"mt-20 grid grid-cols-12 gap-8 border-t border-[#D7EDEF] pt-8\" data-kid=\"1-5-1-4\">\n<h3 class=\"col-span-3 text-[15px] font-medium text-[#255E72]\" data-kid=\"1-5-1-4-1\">Everyday use</h3>\n<dl class=\"col-span-9 grid grid-cols-2 gap-12\" data-kid=\"1-5-1-4-2\">\n<div data-kid=\"1-5-1-4-2-1\">\n<dt class=\"text-[18px] font-medium\" data-kid=\"1-5-1-4-2-1-1\">Habit &amp; Reward System</dt>\n<dd class=\"mt-1 text-[15px] leading-[1.6] text-[#255E72]\" data-kid=\"1-5-1-4-2-1-2\">Daily routines the child completes, with a reward shown on the watch.</dd>\n</div>\n<div data-kid=\"1-5-1-4-2-2\">\n<dt class=\"text-[18px] font-medium\" data-kid=\"1-5-1-4-2-2-1\">Long Battery Life</dt>\n<dd class=\"mt-1 text-[15px] leading-[1.6] text-[#255E72]\" data-kid=\"1-5-1-4-2-2-2\">A stated design goal. No runtime figure is claimed.</dd>\n</div>\n</dl>\n</div>\n</div>\n</section>\n<!-- ZODIAC COLLECTION -->\n<section class=\"bg-[#EAFBFB] py-[130px]\" data-kid=\"1-6\" id=\"collection\">\n<div class=\"mx-auto max-w-[1320px] px-8\" data-kid=\"1-6-1\">\n<div class=\"grid grid-cols-12 items-end gap-8\" data-kid=\"1-6-1-1\">\n<h2 class=\"display col-span-6 text-[46px] leading-[1.1]\" data-kid=\"1-6-1-1-1\">Twelve editions.<br data-kid=\"1-6-1-1-1-1\"/>One SafeKid watch.</h2>\n<p class=\"col-span-5 col-start-8 text-[15px] leading-[1.6] text-[#4A7481]\" data-kid=\"1-6-1-1-2\">\n          Choose an edition to preview it. Every edition is the same watch wearing a different character from the Vietnamese Zodiac.\n        </p>\n</div>\n<div class=\"mt-16 grid grid-cols-[1fr_auto_1fr] items-center gap-10\" data-kid=\"1-6-1-2\">\n<ul aria-label=\"Editions, first six\" class=\"flex flex-col gap-0.5\" data-kid=\"1-6-1-2-1\" id=\"edition-list-left\">\n<li data-kid=\"1-6-1-2-1-1\"><button aria-current=\"true\" class=\"edname group flex w-full items-center justify-end gap-3 py-2.5 text-right text-[17px] text-[#255E72] hover:text-[#0B2B33]\" data-edition=\"rat\" data-kid=\"1-6-1-2-1-1-1\" data-label=\"Mouse\" data-vi=\"Tý\" type=\"button\"><span class=\"dot inline-block h-1.5 w-1.5 rounded-full bg-[#00C7CA]\" data-kid=\"1-6-1-2-1-1-1-1\"></span>Mouse<span class=\"text-[13px] text-[#5A818D]\" data-kid=\"1-6-1-2-1-1-1-2\">Tý</span></button></li>\n<li data-kid=\"1-6-1-2-1-2\"><button class=\"edname flex w-full items-center justify-end gap-3 py-2.5 text-right text-[17px] text-[#255E72] hover:text-[#0B2B33]\" data-edition=\"buffalo\" data-kid=\"1-6-1-2-1-2-1\" data-label=\"Buffalo\" data-vi=\"Sửu\" type=\"button\"><span class=\"dot inline-block h-1.5 w-1.5 rounded-full bg-[#00C7CA]\" data-kid=\"1-6-1-2-1-2-1-1\"></span>Buffalo<span class=\"text-[13px] text-[#5A818D]\" data-kid=\"1-6-1-2-1-2-1-2\">Sửu</span></button></li>\n<li data-kid=\"1-6-1-2-1-3\"><button class=\"edname flex w-full items-center justify-end gap-3 py-2.5 text-right text-[17px] text-[#255E72] hover:text-[#0B2B33]\" data-edition=\"tiger\" data-kid=\"1-6-1-2-1-3-1\" data-label=\"Tiger\" data-vi=\"Dần\" type=\"button\"><span class=\"dot inline-block h-1.5 w-1.5 rounded-full bg-[#00C7CA]\" data-kid=\"1-6-1-2-1-3-1-1\"></span>Tiger<span class=\"text-[13px] text-[#5A818D]\" data-kid=\"1-6-1-2-1-3-1-2\">Dần</span></button></li>\n<li data-kid=\"1-6-1-2-1-4\"><button class=\"edname flex w-full items-center justify-end gap-3 py-2.5 text-right text-[17px] text-[#255E72] hover:text-[#0B2B33]\" data-edition=\"cat\" data-kid=\"1-6-1-2-1-4-1\" data-label=\"Kitty\" data-vi=\"Mão\" type=\"button\"><span class=\"dot inline-block h-1.5 w-1.5 rounded-full bg-[#00C7CA]\" data-kid=\"1-6-1-2-1-4-1-1\"></span>Kitty<span class=\"text-[13px] text-[#5A818D]\" data-kid=\"1-6-1-2-1-4-1-2\">Mão</span></button></li>\n<li data-kid=\"1-6-1-2-1-5\"><button class=\