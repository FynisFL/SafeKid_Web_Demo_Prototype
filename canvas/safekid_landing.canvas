        "h": 0
      },
      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n  :root{\n    --ink:#0B2B33; --teal:#255E72; --cyan:#00C7CA; --mint:#83E3E3; --sky:#B7F2F2;\n    --line:#D7EDEF;\n    --display:'Plus Jakarta Sans',system-ui,sans-serif;\n    --text:'Inter',system-ui,sans-serif;\n  }\n  @layer base{\n    body{background:#fff;color:var(--ink);font-family:var(--text);font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased}\n    a:focus-visible,button:focus-visible{outline:2px solid var(--ink);outline-offset:3px;border-radius:6px}\n  }\n  @layer components{\n    .display{font-family:var(--display);letter-spacing:-.022em;font-weight:600}\n    .pill{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;border-radius:999px;padding:.9rem 1.4rem;font-size:15px;font-weight:500;white-space:nowrap;transition:background-color .2s ease}\n    .edimg{position:absolute;inset:0;height:100%;width:100%;object-fit:contain;opacity:0;transition:opacity .18s ease}\n    .edimg.is-active{opacity:1}\n    .edname{transition:color .18s ease}\n    .edname[aria-current=\"true\"]{color:var(--ink)}\n    .edname[aria-current=\"true\"] .dot{opacity:1;transform:scale(1)}\n    .dot{opacity:0;transform:scale(.4);transition:opacity .18s ease,transform .18s ease}\n    @media (prefers-reduced-motion: reduce){\n      .edimg,.dot,.edname{transition:none}\n    }\n  }\n</style>\n<div class=\"w-full overflow-x-clip bg-white\" data-kid=\"1\" data-name=\"page layout container\">\n<!-- NAV -->\n<header class=\"border-b border-[#E4F4F5]\" data-kid=\"1-1\" data-name=\"site header\">\n<div class=\"flex h-[60px] items-center justify-between px-5\" data-kid=\"1-1-1\" data-name=\"header navigation bar\">\n<a aria-label=\"SafeKid home\" class=\"flex items-center gap-2.5\" data-kid=\"1-1-1-1\" data-name=\"brand logo home link\" href=\"#top\">\n<img alt=\"\" class=\"h-7 w-7 object-contain\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/brand/Logo_SafeKid.png\"/>\n<span class=\"display text-[16px] font-bold tracking-[-.02em]\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">SafeKid</span>\n</a>\n<div class=\"flex items-center gap-2\" data-kid=\"1-1-1-2\" data-name=\"navigation actions group\">\n<a class=\"rounded-full bg-[#0B2B33] px-4 py-2 text-[13px] font-medium text-white\" data-kid=\"1-1-1-2-1\" data-name=\"how it works navigation link\" href=\"#relationship\">How it works</a>\n<button aria-expanded=\"false\" aria-label=\"Open menu\" class=\"grid h-9 w-9 place-items-center rounded-full border border-[#0B2B33]/20\" data-kid=\"1-1-1-2-2\" data-name=\"mobile menu open button\" type=\"button\">\n<i aria-hidden=\"true\" class=\"icon-menu text-[17px]\" data-kid=\"1-1-1-2-2-1\" data-name=\"menu hamburger icon\"></i>\n</button>\n</div>\n</div>\n</header>\n<!-- HERO -->\n<section class=\"bg-[#F4FBFB] px-5 pb-10 pt-8\" data-kid=\"1-2\" data-name=\"hero section\" id=\"top\">\n<h1 class=\"display text-[32px] leading-[1.08]\" data-hero=\"title\" data-kid=\"1-2-1\" data-name=\"hero headline text\">A little more independence.</h1>\n<p class=\"mt-4 text-[15px] leading-[1.6] text-[#255E72]\" data-hero=\"aside\" data-kid=\"1-2-2\" data-name=\"hero subtitle description text\">\n      SafeKid is a smartwatch concept for children aged 4–10, designed around a connected parent-app experience.\n    </p>\n<div class=\"mt-6 flex justify-center\" data-kid=\"1-2-3\" data-name=\"hero product image container\">\n<img alt=\"The SafeKid smartwatch, Mouse edition\" class=\"h-[260px] w-[260px] object-contain drop-shadow-[0_20px_28px_rgba(21,90,102,0.18)]\" data-hero=\"product\" data-kid=\"1-2-3-1\" data-name=\"hero smartwatch product image\" decoding=\"async\" src=\"/api/local/images/src/assets/figma/zodiac-collection-hero-watch.png\"/>\n</div>\n<a class=\"pill mt-6 w-full bg-[#0B2B33] text-white\" data-kid=\"1-2-4\" data-name=\"primary see-how-it-connects CTA\" href=\"#relationship\">See how it connects</a>\n<a class=\"mt-4 block text-center text-[14px] font-medium underline decoration-[#00C7CA] decoration-2 underline-offset-4\" data-kid=\"1-2-5\" data-name=\"browse editions link with underline\" href=\"#collection\">Browse the 12 editions</a>\n<p class=\"mt-4 text-center text-[12px] text-[#4A7481]\" data-kid=\"1-2-6\" data-name=\"concept site disclaimer text\">Concept site. No watch is connected.</p>\n</section>\n<!-- QUESTION -->\n<section class=\"bg-[#0B2B33] px-5 py-14 text-[#EAFBFB]\" data-kid=\"1-3\" data-name=\"question/value section\">\n<h2 class=\"display text-[28px] leading-[1.14] text-[#F2FEFE]\" data-kid=\"1-3-1\" data-name=\"value proposition headline\">More room to explore.<br data-kid=\"1-3-1-1\" data-name=\"line break\"/>A way to stay connected.</h2>\n<p class=\"mt-4 text-[15px] leading-[1.7] text-[#B7F2F2]\" data-kid=\"1-3-2\" data-name=\"value proposition description text\">SafeKid is designed for the years when a child starts walking to a friend's house alone, and a parent starts wondering whether to call.</p>\n<p class=\"mt-3 text-[12px] text-[#8FD3D8]\" data-kid=\"1-3-3\" data-name=\"concept product note text\">Both sides are described as a product concept.</p>\n</section>\n<!-- RELATIONSHIP (static pair, no pinning on mobile) -->\n<section class=\"bg-white px-5 py-14\" data-kid=\"1-4\" data-name=\"relationship section\" id=\"relationship\">\n<p class=\"text-[14px] font-medium text-[#255E72]\" data-kid=\"1-4-1\" data-name=\"section eyebrow label text\">One watch, two perspectives</p>\n<div class=\"mt-7 flex flex-col items-center\" data-kid=\"1-4-2\" data-name=\"relationship diagram container\">\n<img alt=\"SafeKid watch\" class=\"h-[230px] w-[230px] object-contain\" data-kid=\"1-4-2-1\" data-name=\"child watch image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/figma/zodiac-collection-hero-watch.png\"/>\n<p class=\"mt-3 text-[14px] font-medium\" data-kid=\"1-4-2-2\" data-name=\"child watch label text\">Child's watch</p>\n<p class=\"mt-1 text-center text-[13px] text-[#4A7481]\" data-kid=\"1-4-2-3\" data-name=\"child watch description text\">Shows the time and the edition character.</p>\n<div class=\"my-6 flex flex-col items-center gap-1.5\" data-kid=\"1-4-2-4\" data-name=\"connector divider group\">\n<span class=\"block h-10 w-px bg-[#BFE9EA]\" data-kid=\"1-4-2-4-1\" data-name=\"top connector vertical line\"></span>\n<p class=\"text-[12px] text-[#4A7481]\" data-kid=\"1-4-2-4-2\" data-name=\"relationship label text\">the designed relationship</p>\n<span class=\"block h-10 w-px bg-[#9BDDE0]\" data-kid=\"1-4-2-4-3\" data-name=\"bottom connector vertical line\"></span>\n</div>\n<div class=\"w-full rounded-[20px] bg-[#F4FBFB] p-5\" data-kid=\"1-4-2-5\" data-name=\"parent app concept card\">\n<p class=\"text-[12px] font-medium text-[#255E72]\" data-kid=\"1-4-2-5-1\" data-name=\"parent app card title text\">Parent app concept</p>\n<div class=\"mt-3 flex items-center gap-3 rounded-[12px] bg-white px-3.5 py-3\" data-kid=\"1-4-2-5-2\" data-name=\"location view list row\">\n<i aria-hidden=\"true\" class=\"icon-map-pin text-[16px] text-[#255E72]\" data-kid=\"1-4-2-5-2-1\" data-name=\"map pin icon\"></i>\n<p class=\"text-[14px]\" data-kid=\"1-4-2-5-2-2\" data-name=\"location view label text\">Location view</p>\n</div>\n<div class=\"mt-2 flex items-center gap-3 rounded-[14px] bg-white px-3.5 py-3\" data-kid=\"1-4-2-5-3\" data-name=\"call from phone list row\">\n<i aria-hidden=\"true\" class=\"icon-phone text-[16px] text-[#255E72]\" data-kid=\"1-4-2-5-3-1\" data-name=\"phone icon\"></i>\n<p class=\"text-[14px]\" data-kid=\"1-4-2-5-3-2\" data-name=\"call from phone label text\">Call from the phone</p>\n</div>\n<p class=\"mt-3 text-[12px] leading-[1.5] text-[#5A818D]\" data-kid=\"1-4-2-5-4\" data-name=\"parent app concept note text\">Concept screen, drawn only to show where information would appear.</p>\n</div>\n<p class=\"mt-6 text-[14px] leading-[1.6] text-[#255E72]\" data-kid=\"1-4-2-6\" data-name=\"call explanation text\">A call, from both sides: on the watch it is one button, on the phone it is the same call seen from the parent's end.</p>\n<p class=\"mt-4 flex items-start gap-2 text-[12px] leading-[1.5] text-[#4A7481]\" data-kid=\"1-4-2-7\" data-name=\"designed interaction note group\">\n<i aria-hidden=\"true\" class=\"icon-info mt-[2px] text-[13px]\" data-kid=\"1-4-2-7-1\" data-name=\"info icon\"></i>\n        Designed interaction. Not connected to a real watch.\n      </p>\n</div>\n</section>\n<!-- CAPABILITIES -->\n<section class=\"bg-[#F4FBFB] px-5 py-14\" data-kid=\"1-5\" data-name=\"capabilities section\" id=\"features\">\n<h2 class=\"display text-[26px] leading-[1.16]\" data-kid=\"1-5-1\" data-name=\"capabilities headline\">Six designed capabilities.</h2>\n<p class=\"mt-3 text-[13px] leading-[1.55] text-[#4A7481]\" data-kid=\"1-5-2\" data-name=\"capabilities subtitle note\">Only the SOS simulation and the chat screen run on this site.</p>\n<div class=\"mt-7 border-t border-[#CBEAEC] pt-5\" data-kid=\"1-5-3\" data-name=\"location capability group\">\n<p class=\"text-[13px] font-medium text-[#255E72]\" data-kid=\"1-5-3-1\" data-name=\"location capability group heading\">Knowing where they are</p>\n<div class=\"mt-3\" data-kid=\"1-5-3-2\" data-name=\"real time GPS tracking feature block\">\n<p class=\"text-[17px] font-semibold\" data-kid=\"1-5-3-2-1\" data-name=\"real time GPS tracking feature title\">Real-Time GPS Tracking</p>\n<p class=\"mt-1 text-[14px] leading-[1.55] text-[#255E72]\" data-kid=\"1-5-3-2-2\" data-name=\"real time GPS tracking description\">Location information from the watch, shown in the parent-app view.</p>\n</div>\n<div class=\"mt-4\" data-kid=\"1-5-3-3\" data-name=\"safe zone alerts feature block\">\n<p class=\"text-[17px] font-semibold\" data-kid=\"1-5-3-3-1\" data-name=\"safe zone alerts feature title\">Safe Zone Alerts</p>\n<p class=\"mt-1 text-[14px] leading-[1.55] text-[#255E72]\" data-kid=\"1-5-3-3-2\" data-name=\"safe zone alerts description\">A named area around home or school that can raise a notice.</p>\n</div>\n</div>\n<div class=\"mt-7 border-t border-[#CBEAEC] pt-5\" data-kid=\"1-5-4\" data-name=\"communication capability group\">\n<p class=\"text-[13px] font-medium text-[#255E72]\" data-kid=\"1-5-4-1\" data-name=\"communication capability group heading\">Reaching each other</p>\n<div class=\"mt-3\" data-kid=\"1-5-4-2\" data-name=\"two-way calling feature block\">\n<p class=\"text-[17px] font-semibold\" data-kid=\"1-5-4-2-1\" data-name=\"two-way calling feature title\">Two-Way Calling</p>\n<p class=\"mt-1 text-[14px] leading-[1.55] text-[#255E72]\" data-kid=\"1-5-4-2-2\" data-name=\"two-way calling description\">A call in both directions, between the watch and the phone.</p>\n</div>\n<div class=\"mt-4\" data-kid=\"1-5-4-3\" data-name=\"one-touch SOS button feature block\">\n<p class=\"text-[17px] font-semibold\" data-kid=\"1-5-4-3-1\" data-name=\"one-touch SOS button feature title\">One-Touch SOS Button</p>\n<p class=\"mt-1 text-[14px] leading-[1.55] text-[#255E72]\" data-kid=\"1-5-4-3-2\" data-name=\"one-touch SOS button description\">One press is the intended alert path. Here it is a local simulation only: no emergency alert is sent.</p>\n<a class=\"mt-2 inline-flex items-center gap-1.5 text-[13px] font-medium\" data-kid=\"1-5-4-3-3\" data-name=\"open SOS simulation link\" href=\"#demo\">Open the SOS simulation <i aria-hidden=\"true\" class=\"icon-arrow-right text-[13px]\" data-kid=\"1-5-4-3-3-1\" data-name=\"right arrow icon\"></i></a>\n</div>\n</div>\n<div class=\"mt-7 border-t border-[#CBEAEC] pt-5\" data-kid=\"1-5-5\" data-name=\"everyday use capability group\">\n<p class=\"text-[13px] font-medium text-[#255E72]\" data-kid=\"1-5-5-1\" data-name=\"everyday use capability group heading\">Everyday use</p>\n<div class=\"mt-3 flex items-baseline justify-between gap-4\" data-kid=\"1-5-5-2\" data-name=\"habit and reward system row\">\n<p class=\"text-[16px] font-medium\" data-kid=\"1-5-5-2-1\" data-name=\"habit and reward system row title\">Habit &amp; Reward System</p>\n<p class=\"w-[150px] text-[13px] text-[#255E72]\" data-kid=\"1-5-5-2-2\" data-name=\"habit and reward system row description\">Routines, with a reward on the watch.</p>\n</div>\n<div class=\"mt-3 flex items-baseline justify-between gap-4 border-t border-[#E2F2F3] pt-3\" data-kid=\"1-5-5-3\" data-name=\"long battery life row\">\n<p class=\"text-[16px] font-medium\" data-kid=\"1-5-5-3-1\" data-name=\"long battery life row title\">Long Battery Life</p>\n<p class=\"w-[150px] text-[13px] text-[#255E72]\" data-kid=\"1-5-5-3-2\" data-name=\"long battery life row description\">A stated goal. No runtime claimed.</p>\n</div>\n</div>\n</section>\n<!-- COLLECTION -->\n<section class=\"bg-[#EAFBFB] py-16\" data-kid=\"1-6\" data-name=\"collection section\" id=\"collection\">\n<div class=\"px-5\" data-kid=\"1-6-1\" data-name=\"collection content container\">\n<h2 class=\"display text-[26px] leading-[1.16]\" data-kid=\"1-6-1-1\" data-name=\"collection headline\">Twelve editions. One watch.</h2>\n<p class=\"mt-3 text-[14px] leading-[1.55] text-[#4A7481]\" data-kid=\"1-6-1-2\" data-name=\"collection subtitle note\">Tap an edition to preview it. No prices or availability are shown.</p>\n<div class=\"mt-6 flex flex-col items-center\" data-kid=\"1-6-1-3\" data-name=\"edition preview area\">\n<div class=\"relative h-[240px] w-[240px]\" data-kid=\"1-6-1-3-1\" data-name=\"edition image stack\">\n<img alt=\"\" class=\"edimg is-active\" data-edition-img=\"rat\" data-kid=\"1-6-1-3-1-1\" data-name=\"rat edition image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/rat.png\"/>\n<img alt=\"\" class=\"edimg\" data-edition-img=\"buffalo\" data-kid=\"1-6-1-3-1-2\" data-name=\"buffalo edition image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/buffalo.png\"/>\n<img alt=\"\" class=\"edimg\" data-edition-img=\"tiger\" data-kid=\"1-6-1-3-1-3\" data-name=\"tiger edition image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/tiger.png\"/>\n<img alt=\"\" class=\"edimg\" data-edition-img=\"cat\" data-kid=\"1-6-1-3-1-4\" data-name=\"cat edition image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/cat.png\"/>\n<img alt=\"\" class=\"edimg\" data-edition-img=\"dragon\" data-kid=\"1-6-1-3-1-5\" data-name=\"dragon edition image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/dragon.png\"/>\n<img alt=\"\" class=\"edimg\" data-edition-img=\"snake\" data-kid=\"1-6-1-3-1-6\" data-name=\"snake edition image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/snake.png\"/>\n<img alt=\"\" class=\"edimg\" data-edition-img=\"horse\" data-kid=\"1-6-1-3-1-7\" data-name=\"horse edition image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/horse.png\"/>\n<img alt=\"\" class=\"edimg\" data-edition-img=\"sheep\" data-kid=\"1-6-1-3-1-8\" data-name=\"sheep edition image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/sheep.png\"/>\n<img alt=\"\" class=\"edimg\" data-edition-img=\"monkey\" data-kid=\"1-6-1-3-1-9\" data-name=\"monkey edition image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/monkey.png\"/>\n<img alt=\"\" class=\"edimg\" data-edition-img=\"rooster\" data-kid=\"1-6-1-3-1-10\" data-name=\"rooster edition image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/rooster.png\"/>\n<img alt=\"\" class=\"edimg\" data-edition-img=\"dog\" data-kid=\"1-6-1-3-1-11\" data-name=\"dog edition image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/dog.png\"/>\n<img alt=\"\" class=\"edimg\" data-edition-img=\"pig\" data-kid=\"1-6-1-3-1-12\" data-name=\"pig edition image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/pig.png\"/>\n</div>\n<p class=\"mt-2 text-[17px] font-semibold\" data-dynamic=\"true\" data-kid=\"1-6-1-3-2\" data-name=\"selected edition label row\" data-reason=\"label text rewritten by edition selector script on hover/focus/click\"><span data-current-label=\"\" data-dynamic=\"true\" data-kid=\"1-6-1-3-2-1\" data-name=\"selected edition name text\" data-reason=\"text replaced by edition selector script\">Mouse</span> edition</p>\n<p class=\"text-[13px] text-[#4A7481]\" data-dynamic=\"true\" data-kid=\"1-6-1-3-3\" data-name=\"selected edition Vietnamese zodiac row\" data-reason=\"zodiac text rewritten by edition selector script on hover/focus/click\">Vietnamese Zodiac: <span data-current-vi=\"\" data-dynamic=\"true\" data-kid=\"1-6-1-3-3-1\" data-name=\"selected edition Vietnamese zodiac name text\" data-reason=\"text replaced by edition selector script\">Tý</span></p>\n<a class=\"pill mt-4 border border-[#0B2B33]/25 px-5 py-2.5 text-[14px]\" data-current-link=\"\" data-dynamic=\"true\" data-kid=\"1-6-1-3-4\" data-name=\"selected edition view link pill\" data-reason=\"href and aria-label reset from data attributes by edition selector script\" href=\"#/product/rat\"><span data-current-action=\"\" data-dynamic=\"true\" data-kid=\"1-6-1-3-4-1\" data-name=\"selected edition view link action text\" data-reason=\"text replaced by edition selector script\">View Mouse edition</span></a>\n</div>\n<ul class=\"mt-7 grid grid-cols-2 gap-x-3 gap-y-1\" data-kid=\"1-6-1-4\" data-name=\"edition list items\">\n<li data-kid=\"1-6-1-4-1\" data-name=\"rat edition list item\"><button aria-current=\"true\" class=\"edname flex w-full items-center gap-2.5 py-3 text-left text-[15px] text-[#255E72]\" data-edition=\"rat\" data-kid=\"1-6-1-4-1-1\" data-label=\"Mouse\" data-name=\"rat edition select button\" data-vi=\"Tý\" type=\"button\"><span class=\"dot inline-block h-1.5 w-1.5 rounded-full bg-[#00C7CA]\" data-kid=\"1-6-1-4-1-1-1\" data-name=\"active indicator dot\"></span>Mouse<span class=\"text-[12px] text-[#5A818D]\" data-kid=\"1-6-1-4-1-1-2\" data-name=\"Mouse Vietnamese zodiac label\">Tý</span></button></li>\n<li data-kid=\"1-6-1-4-2\" data-name=\"buffalo edition list item\"><button class=\"edname flex w-full items-center gap-2.5 py-3 text-left text-[15px] text-[#255E72]\" data-edition=\"buffalo\" data-kid=\"1-6-1-4-2-1\" data-label=\"Buffalo\" data-name=\"buffalo edition select button\" data-vi=\"Sửu\" type=\"button\"><span class=\"dot inline-block h-1.5 w-1.5 rounded-full bg-[#00C7CA]\" data-kid=\"1-6-1-4-2-1-1\" data-name=\"active indicator dot\"></span>Buffalo<span class=\"text-[12px] text-[#5A818D]\" data-kid=\"1-6-1-4-2-1-2\" data-name=\"Buffalo Vietnamese zodiac label\">Sửu</span></button></li>\n<li data-kid=\"1-6-1-4-3\" data-name=\"tiger edition list item\"><button class=\"edname flex w-full items-center gap-2.5 py-3 text-left text-[15px] text-[#255E72]\" data-edition=\"tiger\" data-kid=\"1-6-1-4-3-1\" data-label=\"Tiger\" data-name=\"tiger edition select button\" data-vi=\"Dần\" type=\"button\"><span class=\"dot inline-block h-1.5 w-1.5 rounded-full bg-[#00C7CA]\" data-kid=\"1-6-1-4-3-1-1\" data-name=\"active indicator dot\"></span>Tiger<span class=\"text-[12px] text-[#5A818D]\" data-kid=\"1-6-1-4-3-1-2\" data-name=\"Tiger Vietnamese zodiac label\">Dần</span></button></li>\n<li data-kid=\"1-6-1-4-4\" data-name=\"cat edition list item\"><button class=\"edname flex w-full items-center gap-2.5 py-3 text-left text-[15px] text-[#255E72]\" data-edition=\"cat\" data-kid=\"1-6-1-4-4-1\" data-label=\"Kitty\" data-name=\"cat edition select button\" data-vi=\"Mão\" type=\"button\"><span class=\"dot inline-block h-1.5 w-1.5 rounded-full bg-[#00C7CA]\" data-kid=\"1-6-1-4-4-1-1\" data-name=\"active indicator dot\"></span>Kitty<span class=\"text-[12px] text-[#5A818D]\" data-kid=\"1-6-1-4-4-1-2\" data-name=\"Kitty Vietnamese zodiac label\">Mão</span></button></li>\n<li data-kid=\"1-6-1-4-5\" data-name=\"dragon edition list item\"><button class=\"edname flex w-full items-center gap-2.5 py-3 text-left text-[15px] text-[#255E72]\" data-edition=\"dragon\" data-kid=\"1-6-1-4-5-1\" data-label=\"Dragon\" data-name=\"dragon edition select button\" data-vi=\"Thìn\" type=\"button\"><span class=\"dot inline-block h-1.5 w-1.5 rounded-full bg-[#00C7CA]\" data-kid=\"1-6-1-4-5-1-1\" data-name=\"active indicator dot\"></span>Dragon<span class=\"text-[12px] text-[#5A818D]\" data-kid=\"1-6-1-4-5-1-2\" data-name=\"Dragon Vietnamese zodiac label\">Thìn</span></button></li>\n<li data-kid=\"1-6-1-4-6\" data-name=\"snake edition list item\"><button class=\"edname flex w-full items-center gap-2.5 py-3 text-left text-[15px] text-[#255E72]\" data-edition=\"snake\" data-kid=\"1-6-1-4-6-1\" data-label=\"Snake\" data-name=\"snake edition select button\" data-vi=\"Tỵ\" type=\"button\"><span class=\"dot inline-block h-1.5 w-1.5 rounded-full bg-[#00C7CA]\" data-kid=\"1-6-1-4-6-1-1\" data-name=\"active indicator dot\"></span>Snake<span class=\"text-[12px] text-[#5A818D]\" data-kid=\"1-6-1-4-6-1-2\" data-name=\"Snake Vietnamese zodiac label\">Tỵ</span></button></li>\n<li data-kid=\"1-6-1-4-7\" data-name=\"horse edition list item\"><button class=\"edname flex w-full items-center gap-2.5 py-3 text-left text-[15px] text-[#255E72]\" data-edition=\"horse\" data-kid=\"1-6-1-4-7-1\" data-label=\"Pony\" data-name=\"horse edition select button\" data-vi=\"Ngọ\" type=\"button\"><span class=\"dot inline-block h-1.5 w-1.5 rounded-full bg-[#00C7CA]\" data-kid=\"1-6-1-4-7-1-1\" data-name=\"active indicator dot\"></span>Pony<span class=\"text-[12px] text-[#5A818D]\" data-kid=\"1-6-1-4-7-1-2\" data-name=\"Pony Vietnamese zodiac label\">Ngọ</span></button></li>\n<li data-kid=\"1-6-1-4-8\" data-name=\"sheep edition list item\"><button class=\"edname flex w-full items-center gap-2.5 py-3 text-left text-[15px] text-[#255E72]\" data-edition=\"sheep\" data-kid=\"1-6-1-4-8-1\" data-label=\"Sheep\" data-name=\"sheep edition select button\" data-vi=\"Mùi\" type=\"button\"><span class=\"dot inline-block h-1.5 w-1.5 rounded-full bg-[#00C7CA]\" data-kid=\"1-6-1-4-8-1-1\" data-name=\"active indicator dot\"></span>Sheep<span class=\"text-[12px] text-[#5A818D]\" data-kid=\"1-6-1-4-8-1-2\" data-name=\"Sheep Vietnamese zodiac label\">Mùi</span></button></li>\n<li data-kid=\"1-6-1-4-9\" data-name=\"monkey edition list item\"><button class=\"edname flex w-full items-center gap-2.5 py-3 text-left text-[15px] text-[#255E72]\" data-edition=\"monkey\" data-kid=\"1-6-1-4-9-1\" data-label=\"Monkey\" data-name=\"monkey edition select button\" data-vi=\"Thân\" type=\"button\"><span class=\"dot inline-block h-1.5 w-1.5 rounded-full bg-[#00C7CA]\" data-kid=\"1-6-1-4-9-1-1\" data-name=\"active indicator dot\"></span>Monkey<span class=\"text-[12px] text-[#5A818D]\" data-kid=\"1-6-1-4-9-1-2\" data-name=\"Monkey Vietnamese zodiac label\">Thân</span></button></li>\n<li data-kid=\"1-6-1-4-10\" data-name=\"rooster edition list item\"><button class=\"edname flex w-full items-center gap-2.5 py-3 text-left text-[15px] text-[#255E72]\" data-edition=\"rooster\" data-kid=\"1-6-1-4-10-1\" data-label=\"Chick\" data-name=\"rooster edition select button\" data-vi=\"Dậu\" type=\"button\"><span class=\"dot inline-block h-1.5 w-1.5 rounded-full bg-[#00C7CA]\" data-kid=\"1-6-1-4-10-1-1\" data-name=\"active indicator dot\"></span>Chick<span class=\"text-[12px] text-[#5A818D]\" data-kid=\"1-6-1-4-10-1-2\" data-name=\"Chick Vietnamese zodiac label\">Dậu</span></button></li>\n<li data-kid=\"1-6-1-4-11\" data-name=\"dog edition list item\"><button class=\"edname flex w-full items-center gap-2.5 py-3 text-left text-[15px] text-[#255E72]\" data-edition=\"dog\" data-kid=\"1-6-1-4-11-1\" data-label=\"Puppy\" data-name=\"dog edition select button\" data-vi=\"Tuất\" type=\"button\"><span class=\"dot inline-block h-1.5 w-1.5 rounded-full bg-[#00C7CA]\" data-kid=\"1-6-1-4-11-1-1\" data-name=\"active indicator dot\"></span>Puppy<span class=\"text-[12px] text-[#5A818D]\" data-kid=\"1-6-1-4-11-1-2\" data-name=\"Puppy Vietnamese zodiac label\">Tuất</span></button></li>\n<li data-kid=\"1-6-1-4-12\" data-name=\"pig edition list item\"><button class=\"edname flex w-full items-center gap-2.5 py-3 text-left text-[15px] text-[#255E72]\" data-edition=\"pig\" data-kid=\"1-6-1-4-12-1\" data-label=\"Piggy\" data-name=\"pig edition select button\" data-vi=\"Hợi\" type=\"button\"><span class=\"dot inline-block h-1.5 w-1.5 rounded-full bg-[#00C7CA]\" data-kid=\"1-6-1-4-12-1-1\" data-name=\"active indicator dot\"></span>Piggy<span class=\"text-[12px] text-[#5A818D]\" data-kid=\"1-6-1-4-12-1-2\" data-name=\"Piggy Vietnamese zodiac label\">Hợi</span></button></li>\n</ul>\n<a class=\"mt-4 inline-flex items-center gap-2 text-[14px] font-medium\" data-kid=\"1-6-1-5\" data-name=\"open collection page link\" href=\"#/zodiac\">Open the collection page <i aria-hidden=\"true\" class=\"icon-arrow-right text-[14px]\" data-kid=\"1-6-1-5-1\" data-name=\"right arrow icon\"></i></a>\n<p aria-live=\"polite\" class=\"sr-only\" data-kid=\"1-6-1-6\" data-live=\"\" data-name=\"screen reader live region\"></p>\n</div>\n</section>\n<!-- DEMO -->\n<section class=\"bg-[#0B2B33] px-5 py-16 text-white\" data-kid=\"1-7\" data-name=\"demo section\" id=\"demo\">\n<h2 class=\"display text-[26px] leading-[1.16] text-[#F2FEFE]\" data-kid=\"1-7-1\" data-name=\"demo section headline\">Try what exists.</h2>\n<p class=\"mt-3 text-[14px] leading-[1.6] text-[#B7F2F2]\" data-kid=\"1-7-2\" data-name=\"demo section subtitle text\">A local pairing demonstration, then the two prototypes that run on this site.</p>\n<div class=\"mt-7 rounded-[20px] border border-white/15 p-4\" data-kid=\"1-7-3\" data-name=\"steps demo card\">\n<p class=\"text-[12px] font-medium text-[#8FD3D8]\" data-kid=\"1-7-3-1\" data-name=\"step 1 label text\">Step 1 — sample watch</p>\n<div class=\"mt-3 flex items-center gap-4\" data-kid=\"1-7-3-2\" data-name=\"sample watch row\">\n<img alt=\"Sample watch\" class=\"h-20 w-20 object-contain\" data-kid=\"1-7-3-2-1\" data-name=\"sample watch image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/rat.png\"/>\n<div data-kid=\"1-7-3-2-2\" data-name=\"sample watch details\">\n<p class=\"text-[15px] font-medium\" data-kid=\"1-7-3-2-2-1\" data-name=\"sample watch edition name text\">Mouse edition</p>\n<p class=\"mt-1 text-[12px] leading-[1.45] text-[#9FDDE2]\" data-kid=\"1-7-3-2-2-2\" data-name=\"sample watch edition note text\">A sample edition for this demonstration only.</p>\n</div>\n</div>\n<button class=\"mt-4 w-full rounded-full bg-white px-5 py-2.5 text-[14px] font-medium text-[#0B2B33]\" data-dynamic=\"true\" data-kid=\"1-7-3-3\" data-name=\"select sample watch button\" data-reason=\"button label and background class reinitialized by pairing demo script\" data-select-watch=\"\" type=\"button\">Select sample watch</button>\n<p class=\"mt-6 text-[12px] font-medium text-[#8FD3D8]\" data-kid=\"1-7-3-4\" data-name=\"step 2 label text\">Step 2 — parent-app demo</p>\n<div class=\"mt-3 rounded-[14px] bg-white/8 px-4 py-3\" data-kid=\"1-7-3-5\" data-name=\"parent app demo card\">\n<div class=\"flex items-center gap-2.5\" data-kid=\"1-7-3-5-1\" data-name=\"phone confirm row\">\n<i aria-hidden=\"true\" class=\"icon-phone text-[15px] text-[#B7F2F2]\" data-kid=\"1-7-3-5-1-1\" data-name=\"phone icon\"></i>\n<p class=\"text-[14px]\" data-kid=\"1-7-3-5-1-2\" data-name=\"phone confirm action text\">Confirm from the phone</p>\n</div>\n<p class=\"mt-1 text-[12px] leading-[1.45] text-[#9FDDE2]\" data-kid=\"1-7-3-5-2\" data-name=\"parent app demo effect note\">The only effect is a line of text on this page.</p>\n</div>\n<button class=\"mt-3 w-full rounded-full bg-[#00C7CA] px-5 py-2.5 text-[14px] font-medium text-[#04262E] disabled:opacity-35\" data-confirm-pairing=\"\" data-dynamic=\"true\" data-kid=\"1-7-3-6\" data-name=\"confirm demo pairing button\" data-reason=\"disabled state and label reinitialized by pairing demo script\" disabled=\"\" type=\"button\">Confirm demo pairing</button>\n<div class=\"mt-3 flex items-center justify-between\" data-kid=\"1-7-3-7\" data-name=\"step 3 result bar\">\n<p aria-live=\"polite\" class=\"text-[12px] text-[#8FD3D8]\" data-dynamic=\"true\" data-kid=\"1-7-3-7-1\" data-name=\"pairing result text\" data-pairing-result=\"\" data-reason=\"status text rewritten by pairing demo script\" role=\"status\">Not started.</p>\n<button class=\"inline-flex items-center gap-1.5 text-[12px] text-[#9FDDE2]\" data-kid=\"1-7-3-7-2\" data-name=\"reset pairing demo button\" data-reset-pairing=\"\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-rotate-ccw text-[13px]\" data-kid=\"1-7-3-7-2-1\" data-name=\"rotate ccw icon\"></i> Reset</button>\n</div>\n</div>\n<div class=\"mt-7\" data-kid=\"1-7-4\" data-name=\"demo prototypes list\">\n<div class=\"flex items-center justify-between border-t border-white/15 py-4\" data-kid=\"1-7-4-1\" data-name=\"SOS simulation list item container\">\n<p class=\"text-[15px] font-medium\" data-kid=\"1-7-4-1-1\" data-name=\"SOS simulation list item title\">SOS simulation</p>\n<a class=\"inline-flex items-center gap-1.5 text-[13px] text-white\" data-kid=\"1-7-4-1-2\" data-name=\"SOS simulation open link\" href=\"#/sos\">Open <i aria-hidden=\"true\" class=\"icon-arrow-right text-[13px]\" data-kid=\"1-7-4-1-2-1\" data-name=\"right arrow icon\"></i></a>\n</div>\n<p class=\"-mt-2 mb-3 text-[12px] leading-[1.5] text-[#9FDDE2]\" data-kid=\"1-7-4-2\" data-name=\"SOS simulation disclaimer text\">Acknowledges a press. No alert, call or location is sent.</p>\n<div class=\"flex items-center justify-between border-t border-white/15 py-4\" data-kid=\"1-7-4-3\" data-name=\"S.F AI chat prototype list item container\">\n<p class=\"text-[15px] font-medium\" data-kid=\"1-7-4-3-1\" data-name=\"S.F AI chat prototype list item title\">S.F AI chat prototype</p>\n<a class=\"inline-flex items-center gap-1.5 text-[13px] text-white\" data-kid=\"1-7-4-3-2\" data-name=\"S.F AI chat prototype open link\" href=\"#/chat\">Open <i aria-hidden=\"true\" class=\"icon-arrow-right text-[13px]\" data-kid=\"1-7-4-3-2-1\" data-name=\"right arrow icon\"></i></a>\n</div>\n<p class=\"-mt-2 mb-3 text-[12px] leading-[1.5] text-[#9FDDE2]\" data-kid=\"1-7-4-4\" data-name=\"S.F AI chat prototype disclaimer text\">Messages are not sent. Not emergency support.</p>\n<div class=\"flex items-center justify-between border-y border-white/15 py-4\" data-kid=\"1-7-4-5\" data-name=\"edition details list item container\">\n<p class=\"text-[15px] font-medium\" data-dynamic=\"true\" data-kid=\"1-7-4-5-1\" data-name=\"edition details list item title\" data-reason=\"current edition label rewritten by edition selector script\"><span data-current-label=\"\" data-dynamic=\"true\" data-kid=\"1-7-4-5-1-1\" data-name=\"edition details current edition name text\" data-reason=\"text replaced by edition selector script\">Mouse</span> edition details</p>\n<a class=\"inline-flex items-center gap-1.5 text-[13px] text-white\" data-current-link=\"\" data-dynamic=\"true\" data-kid=\"1-7-4-5-2\" data-name=\"edition details open link\" data-reason=\"href and aria-label reset from data attributes by edition selector script\" href=\"#/product/rat\">Open <i aria-hidden=\"true\" class=\"icon-arrow-right text-[13px]\" data-kid=\"1-7-4-5-2-1\" data-name=\"right arrow icon\"></i></a>\n</div>\n</div>\n</section>\n<!-- CLOSING -->\n<section class=\"bg-white px-5 pb-14 pt-14\" data-kid=\"1-8\" data-name=\"closing section\">\n<p class=\"text-[12px] text-[#5A818D]\" data-kid=\"1-8-1\" data-name=\"creator credit text\">Developed by <span class=\"font-medium text-[#255E72]\" data-kid=\"1-8-1-1\" data-name=\"creator name text\">DigiBabi</span></p>\n<h2 class=\"display mt-6 text-[26px] leading-[1.16]\" data-kid=\"1-8-2\" data-name=\"closing question headline\">Which one feels like theirs?</h2>\n<div class=\"mt-6 flex items-center gap-4\" data-kid=\"1-8-3\" data-name=\"selected edition preview container\">\n<img alt=\"Selected edition\" class=\"h-[86px] w-[86px] object-contain\" data-closing-img=\"\" data-dynamic=\"true\" data-kid=\"1-8-3-1\" data-name=\"selected edition image\" data-reason=\"src attribute rewritten by edition selector script\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/products/rat.png\"/>\n<div data-kid=\"1-8-3-2\" data-name=\"selected edition preview details\">\n<p class=\"text-[15px] font-medium\" data-dynamic=\"true\" data-kid=\"1-8-3-2-1\" data-name=\"selected edition name row\" data-reason=\"current edition label rewritten by edition selector script\"><span data-current-label=\"\" data-dynamic=\"true\" data-kid=\"1-8-3-2-1-1\" data-name=\"selected edition current name text\" data-reason=\"text replaced by edition selector script\">Mouse</span> edition</p>\n<p class=\"text-[12px] text-[#4A7481]\" data-dynamic=\"true\" data-kid=\"1-8-3-2-2\" data-name=\"selected edition Vietnamese zodiac row\" data-reason=\"zodiac text rewritten by edition selector script\">Vietnamese Zodiac: <span data-current-vi=\"\" data-dynamic=\"true\" data-kid=\"1-8-3-2-2-1\" data-name=\"selected edition Vietnamese zodiac name text\" data-reason=\"text replaced by edition selector script\">Tý</span></p>\n</div>\n</div>\n<a class=\"pill mt-4 w-full bg-[#0B2B33] text-white\" data-current-link=\"\" data-dynamic=\"true\" data-kid=\"1-8-4\" data-name=\"view selected edition CTA\" data-reason=\"href and aria-label reset from data attributes by edition selector script\" href=\"#/product/rat\"><span data-current-action=\"\" data-dynamic=\"true\" data-kid=\"1-8-4-1\" data-name=\"view selected edition CTA text\" data-reason=\"text replaced by edition selector script\">View Mouse edition</span></a>\n<a class=\"mt-4 block text-center text-[14px] font-medium\" data-kid=\"1-8-5\" data-name=\"ask about SafeKid link\" href=\"#/contact\">Ask about SafeKid</a>\n</section>\n<!-- FOOTER -->\n<footer class=\"bg-[#F4FBFB] px-5 pb-6 pt-10\" data-kid=\"1-9\" data-name=\"footer\">\n<div class=\"flex items-center gap-2.5\" data-kid=\"1-9-1\" data-name=\"footer brand block\">\n<img alt=\"\" class=\"h-7 w-7 object-contain\" data-kid=\"1-9-1-1\" data-name=\"footer brand logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/brand/Logo_SafeKid.png\"/>\n<div data-kid=\"1-9-1-2\" data-name=\"footer brand text group\">\n<p class=\"display text-[15px] font-bold\" data-kid=\"1-9-1-2-1\" data-name=\"footer brand name text\">SafeKid</p>\n<p class=\"text-[12px] text-[#4A7481]\" data-kid=\"1-9-1-2-2\" data-name=\"footer brand tagline text\">Inspired by the Vietnamese Zodiac.</p>\n</div>\n</div>\n<div class=\"mt-6 grid grid-cols-2 gap-6 text-[13px] text-[#255E72]\" data-kid=\"1-9-2\" data-name=\"footer navigation link grid\">\n<div class=\"flex flex-col gap-1.5\" data-kid=\"1-9-2-1\" data-name=\"primary footer navigation column\">\n<a data-kid=\"1-9-2-1-1\" data-name=\"footer home link\" href=\"#top\">Home</a>\n<a data-kid=\"1-9-2-1-2\" data-name=\"footer capabilities link\" href=\"#features\">Capabilities</a>\n<a data-kid=\"1-9-2-1-3\" data-name=\"footer zodiac collection link\" href=\"#/zodiac\">Zodiac Collection</a>\n<a data-kid=\"1-9-2-1-4\" data-name=\"footer about link\" href=\"#/about\">About</a>\n</div>\n<div class=\"flex flex-col gap-1.5\" data-kid=\"1-9-2-2\" data-name=\"secondary footer navigation column\">\n<a data-kid=\"1-9-2-2-1\" data-name=\"footer support link\" href=\"#/support\">Support</a>\n<a data-kid=\"1-9-2-2-2\" data-name=\"footer contact link\" href=\"#/contact\">Contact</a>\n<a data-kid=\"1-9-2-2-3\" data-name=\"footer SOS simulation link\" href=\"#/sos\">SOS simulation</a>\n<a data-kid=\"1-9-2-2-4\" data-name=\"footer S.F AI prototype link\" href=\"#/chat\">S.F AI prototype</a>\n</div>\n</div>\n<div class=\"mt-6 border-t border-[#D7EDEF] pt-4 text-[12px] text-[#5A818D]\" data-kid=\"1-9-3\" data-name=\"footer legal text group\">\n<p data-kid=\"1-9-3-1\" data-name=\"footer copyright text\">© 2026 SafeKid. Concept site for demonstration.</p>\n<p class=\"mt-1\" data-kid=\"1-9-3-2\" data-name=\"footer developer credit text\">Developed by DigiBabi</p>\n</div>\n</footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script>\n(function(){\n  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n  /* edition selector */\n  var buttons = Array.prototype.slice.call(document.querySelectorAll('[data-edition]'));\n  var stack = Array.prototype.slice.call(document.querySelectorAll('[data-edition-img]'));\n  var closingImg = document.querySelector('[data-closing-img]');\n  var live = document.querySelector('[data-live]');\n  var committed = 'rat';\n\n  function paint(id, announce){\n    stack.forEach(function(img){ img.classList.toggle('is-active', img.getAttribute('data-edition-img') === id); });\n    var btn = buttons.filter(function(b){ return b.getAttribute('data-edition') === id; })[0];\n    if (!btn) return;\n    var label = btn.getAttribute('data-label'), vi = btn.getAttribute('data-vi');\n    document.querySelectorAll('[data-current-label]').forEach(function(el){ el.textContent = label; });\n    document.querySelectorAll('[data-current-vi]').forEach(function(el){ el.textContent = vi; });\n    document.querySelectorAll('[data-current-action]').forEach(function(el){ el.textContent = 'View ' + label + ' edition'; });\n    document.querySelectorAll('[data-current-link]').forEach(function(el){\n      el.setAttribute('href', '#/product/' + id);\n      el.setAttribute('aria-label', 'View ' + label + ' edition details');\n    });\n    if (closingImg) closingImg.src = '/api/local/images/src/assets/products/' + id + '.png';\n    buttons.forEach(function(b){ b.setAttribute('aria-current', b.getAttribute('data-edition') === id ? 'true' : 'false'); });\n    if (announce && live) live.textContent = label + ' edition selected.';\n  }\n  buttons.forEach(function(btn){\n    var id = btn.getAttribute('data-edition');\n    btn.addEventListener('mouseenter', function(){ paint(id, false); });\n    btn.addEventListener('focus', function(){ paint(id, false); });\n    btn.addEventListener('click', function(){ committed = id; paint(id, true); });\n  });\n  paint(committed, false);\n\n  /* pairing demo */\n  var selected = false, paired = false;\n  var selBtn = document.querySelector('[data-select-watch]');\n  var confBtn = document.querySelector('[data-confirm-pairing]');\n  var resetBtn = document.querySelector('[data-reset-pairing]');\n  var result = document.querySelector('[data-pairing-result]');\n\n  function pairingUI(){\n    if (!selBtn || !confBtn || !result) return;\n    selBtn.textContent = selected ? 'Sample watch selected' : 'Select sample watch';\n    selBtn.classList.toggle('bg-white', !selected);\n    selBtn.classList.toggle('bg-[#00C7CA]', selected);\n    confBtn.disabled = !selected;\n    if (paired) result.textContent = 'Demo paired. No real watch is connected.';\n    else if (selected) result.textContent = 'Step 1 done. Confirm to finish.';\n    else result.textContent = 'Not started.';\n  }\n  if (selBtn) selBtn.addEventListener('click', function(){ if (!paired) { selected = true; pairingUI(); } });\n  if (confBtn) confBtn.addEventListener('click', function(){ if (selected) { paired = true; pairingUI(); } });\n  if (resetBtn) resetBtn.addEventListener('click', function(){ selected = false; paired = false; pairingUI(); });\n  pairingUI();\n\n  /* entrance: transform only so the page is legible without motion */\n  if (window.gsap && !reduce) {\n    gsap.from('[data-hero=\"product\"]', { y: 24, scale: .96, duration: .8, ease: 'power3.out' });\n    gsap.from('[data-hero=\"title\"]', { y: 16, duration: .7, delay: .1, ease: 'power3.out' });\n    gsap.from('[data-hero=\"aside\"]', { y: 12, duration: .7, delay: .18, ease: 'power3.out' });\n  }\n})();\n</script>",
